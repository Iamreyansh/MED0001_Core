meta {
  name: check-availability
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/catalogue/check-availability
  body: json
  auth: none
}

body:json {
  {
    "medicine_ids": ["{{medicineId}}"],
    "pharmacy_id": "{{pharmacyId}}"
  }
}

script:pre-request {
  const baseUrl = bru.getEnvVar("baseUrl");
  if (!baseUrl) {
    bru.setEnvVar("baseUrl", "http://localhost:8080");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("availability envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.pharmacy_id).to.be.a("string");
    expect(body.data.results).to.be.an("array");
    expect(body.data.checked_at).to.be.a("string");
  });
}

docs {
  POST /api/v1/catalogue/check-availability — ≤50 medicine_ids; public; optional JWT for higher rate limit.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/catalogue/check-availability
    method: post
    body:json: {
      {
        "medicine_ids": ["11111111-1111-4111-8111-111111111111"],
        "pharmacy_id": "aaaaaaaa-0009-0009-0009-000000000001"
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "pharmacy_id": "aaaaaaaa-0009-0009-0009-000000000001",
            "pharmacy_name": "Sharma Medical Store",
            "pharmacy_is_online": true,
            "checked_at": "2026-08-08T00:00:00Z",
            "results": [
              {
                "medicine_id": "11111111-1111-4111-8111-111111111111",
                "name": "Augmentin 625 Tablet",
                "in_stock": true,
                "stock_quantity": 48,
                "pharmacy_price": 215.00,
                "is_rx_only": true
              }
            ]
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 400 MEDICINE_IDS_REQUIRED
  request: {
    url: {{baseUrl}}/api/v1/catalogue/check-availability
    method: post
    body:json: {
      {
        "medicine_ids": [],
        "pharmacy_id": "aaaaaaaa-0009-0009-0009-000000000001"
      }
    }
  }
  response: {
    status: { code: 400 text: Bad Request }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": { "code": "MEDICINE_IDS_REQUIRED", "message": "medicine_ids array is empty" }
        }
      '''
    }
  }
}
