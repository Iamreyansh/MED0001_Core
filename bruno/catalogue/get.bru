meta {
  name: get
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/catalogue/{{medicineId}}?lat=12.93&lng=77.62
  body: none
  auth: none
}

params:query {
  lat: 12.93
  lng: 77.62
}

script:pre-request {
  const baseUrl = bru.getEnvVar("baseUrl");
  if (!baseUrl) {
    bru.setEnvVar("baseUrl", "http://localhost:8080");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.medicine_id) {
    bru.setEnvVar("medicineId", body.data.medicine_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("detail envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.medicine_id).to.be.a("string");
    expect(body.data.stocking_pharmacies_nearby).to.be.an("array");
    expect(body.data.substitutes).to.be.an("array");
  });
}

docs {
  GET /api/v1/catalogue/:id — public detail; banned → 410 MEDICINE_BANNED. Redis catalogue:medicine:{id} TTL 5m.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/catalogue/11111111-1111-4111-8111-111111111111?lat=12.93&lng=77.62
    method: get
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "medicine_id": "11111111-1111-4111-8111-111111111111",
            "name": "Augmentin 625 Tablet",
            "salt_composition": "Amoxicillin (500mg) + Clavulanic Acid (125mg)",
            "manufacturer": "GSK India",
            "category": { "name": "Antibiotics", "slug": "antibiotics" },
            "form": "TABLET",
            "pack_size": 10,
            "pack_unit": "TABLET",
            "schedule": "H",
            "is_rx_only": true,
            "rx_required": true,
            "available_online": true,
            "description": "Combo antibiotic",
            "typical_mrp": 218.50,
            "stocking_pharmacies_nearby": [],
            "substitutes": []
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 410 MEDICINE_BANNED
  request: {
    url: {{baseUrl}}/api/v1/catalogue/22222222-2222-4222-8222-222222222222
    method: get
  }
  response: {
    status: { code: 410 text: Gone }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": { "code": "MEDICINE_BANNED", "message": "Medicine is banned and not publicly accessible" }
        }
      '''
    }
  }
}
