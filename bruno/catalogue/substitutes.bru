meta {
  name: substitutes
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/catalogue/substitutes/{{medicineId}}
  body: none
  auth: none
}

script:pre-request {
  const baseUrl = bru.getEnvVar("baseUrl");
  if (!baseUrl) {
    bru.setEnvVar("baseUrl", "http://localhost:8080");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("substitutes envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.medicine_id).to.be.a("string");
    expect(body.data.substitutes).to.be.an("array");
  });
}

docs {
  GET /api/v1/catalogue/substitutes/:medicine_id — one-hop substitutes only.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/catalogue/substitutes/11111111-1111-4111-8111-111111111111
    method: get
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "medicine_id": "11111111-1111-4111-8111-111111111111",
            "medicine_name": "Augmentin 625 Tablet",
            "substitutes": []
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 404 MEDICINE_NOT_FOUND
  request: {
    url: {{baseUrl}}/api/v1/catalogue/substitutes/00000000-0000-4000-8000-000000000099
    method: get
  }
  response: {
    status: { code: 404 text: Not Found }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": { "code": "MEDICINE_NOT_FOUND", "message": "Medicine not found" }
        }
      '''
    }
  }
}
