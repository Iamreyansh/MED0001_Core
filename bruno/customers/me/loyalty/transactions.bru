meta {
  name: transactions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/customers/me/loyalty/transactions
  body: none
  auth: bearer
  params:query {
    page: 1
    limit: 20
    order: desc
    ~type: EARN
  }
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && Array.isArray(body.data) && body.data[0]) {
    bru.setEnvVar("loyaltyTxId", body.data[0].id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("success envelope with pagination meta", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.be.an("array");
    expect(body.meta).to.have.property("page");
    expect(body.meta).to.have.property("total");
  });
}

docs {
  GET /api/v1/customers/me/loyalty/transactions — EARN/REVERSE ledger.
  Query: page, limit, order, type (EARN|REVERSE).
  Rate limit: 20 req/min per user.
  Errors: 400 VALIDATION_ERROR (invalid type), 401 UNAUTHORIZED, 429 RATE_LIMITED
}

example {
  name: 200 OK
  description: Paginated loyalty transactions.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/loyalty/transactions?page=1&limit=20&order=desc
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": [
            {
              "id": "a1b2c3d4-e5f6-4789-a012-3456789abcde",
              "type": "EARN",
              "points": 3,
              "points_balance_after": 38,
              "description": "Points for order #ORD-20260720-00123 (Rs 350 spent)",
              "reference_id": "b2c3d4e5-f6a7-4890-b123-456789abcdef",
              "created_at": "2026-07-20T18:00:00Z"
            }
          ],
          "meta": {
            "page": 1,
            "limit": 20,
            "total": 1,
            "has_next": false
          }
        }
      '''
    }
  }
}
