meta {
  name: get
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/customers/me/wallet
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.wallet_id) {
    bru.setEnvVar("walletId", body.data.wallet_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("success envelope with wallet balance", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.wallet_id).to.be.a("string").that.is.not.empty;
    expect(body.data.currency).to.equal("INR");
    expect(body.data).to.have.property("balance");
    expect(body.data).to.have.property("lifetime_credited");
    expect(body.data).to.have.property("lifetime_debited");
    expect(body.data.expiring_soon).to.be.an("object");
  });
}

docs {
  GET /api/v1/customers/me/wallet — Namma Money balance.
  Errors: 401 UNAUTHORIZED
}

example {
  name: 200 OK
  description: Wallet balance with lifetime totals and expiring-soon summary.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/wallet
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "wallet_id": "a1b2c3d4-e5f6-4789-a012-3456789abcde",
            "balance": 125.00,
            "lifetime_credited": 250.00,
            "lifetime_debited": 125.00,
            "expiring_soon": {
              "amount": 50.00,
              "expires_before": "2026-08-05T10:00:00Z"
            },
            "currency": "INR"
          }
        }
      '''
    }
  }
}

example {
  name: 401 UNAUTHORIZED
  description: Missing or invalid bearer token.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/wallet
    method: get
    mode: none
  }

  response: {
    status: {
      code: 401
      text: Unauthorized
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "UNAUTHORIZED",
            "message": "Customer authentication required"
          }
        }
      '''
    }
  }
}
