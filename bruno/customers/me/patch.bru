meta {
  name: patch
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/v1/customers/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Ramesh Kumar",
    "preferred_language": "kn"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.id) {
    bru.setEnvVar("customerId", body.data.id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("success envelope with updated profile", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.id).to.be.a("string").that.is.not.empty;
    expect(body.data.name).to.equal("Ramesh Kumar");
    expect(body.data.preferred_language).to.equal("kn");
    expect(body.data.updated_at).to.be.a("string").that.is.not.empty;
  });
}

docs {
  PATCH /api/v1/customers/me — update own profile (name, avatar_url, date_of_birth, gender, preferred_language).
  Errors: 400 VALIDATION_ERROR, 401 UNAUTHORIZED
}

example {
  name: 200 OK
  description: Profile fields updated; returns id and updated_at.

  request: {
    url: {{baseUrl}}/api/v1/customers/me
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "name": "Ramesh Kumar",
        "preferred_language": "kn"
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
            "phone": "+919876543210",
            "name": "Ramesh Kumar",
            "avatar_url": "https://cdn.namma-medmate.in/avatars/ramesh.png",
            "date_of_birth": "1990-01-15",
            "gender": "MALE",
            "preferred_language": "kn",
            "updated_at": "2026-07-26T10:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 400 VALIDATION_ERROR
  description: preferred_language must be a supported ISO 639-1 code.

  request: {
    url: {{baseUrl}}/api/v1/customers/me
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "preferred_language": "xx"
      }
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "preferred_language must be one of: en, kn, hi, ta, te, ml, mr"
          }
        }
      '''
    }
  }
}
