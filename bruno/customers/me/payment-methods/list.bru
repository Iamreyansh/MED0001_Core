meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/customers/me/payment-methods
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
}

script:post-response {
  const body = res.getBody();
  if (!(body && body.success && body.data)) {
    return;
  }
  const upi = body.data.upi || [];
  const cards = body.data.cards || [];
  if (upi.length > 0 && upi[0].id) {
    bru.setEnvVar("paymentMethodId", upi[0].id);
  } else if (cards.length > 0 && cards[0].id) {
    bru.setEnvVar("paymentMethodId", cards[0].id);
  }
  const def = [...upi, ...cards].find((m) => m.is_default);
  if (def && def.id) {
    bru.setEnvVar("defaultPaymentMethodId", def.id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("success envelope with upi and cards arrays (masked)", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.upi).to.be.an("array");
    expect(body.data.cards).to.be.an("array");
    for (const u of body.data.upi) {
      expect(u).to.not.have.property("upi_id");
      expect(u.upi_handle).to.match(/^\*\*\*@/);
    }
    for (const c of body.data.cards) {
      expect(c).to.not.have.property("gateway_token_id");
      expect(c.card_last4).to.be.a("string");
    }
  });
}

docs {
  GET /api/v1/customers/me/payment-methods — list masked UPI + cards.
  Errors: 401 UNAUTHORIZED
}

example {
  name: 200 OK
  description: Masked UPI + cards; raw upi_id / gateway_token_id never present.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/payment-methods
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "upi": [
              {
                "id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
                "type": "UPI",
                "nickname": "GPay",
                "upi_handle": "***@okaxis",
                "is_default": true,
                "added_at": "2026-07-26T10:00:00Z"
              }
            ],
            "cards": [
              {
                "id": "8f14e45f-ceea-467a-9571-d2a0f3c8b9d1",
                "type": "CARD",
                "card_last4": "4242",
                "card_network": "VISA",
                "card_type": "CREDIT",
                "nickname": "Axis Flipkart",
                "is_default": false,
                "added_at": "2026-07-26T10:05:00Z"
              }
            ]
          }
        }
      '''
    }
  }
}

example {
  name: 401 UNAUTHORIZED
  description: Missing or invalid bearer token.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/payment-methods
    method: get
    mode: none
  }

  response: {
    status: {
      code: 401
      text: Unauthorized
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "UNAUTHORIZED",
            "message": "Authentication required"
          }
        }
      '''
    }
  }
}
