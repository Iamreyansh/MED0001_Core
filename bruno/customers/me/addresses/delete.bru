meta {
  name: delete
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/v1/customers/me/addresses/{{addressId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
  if (!bru.getEnvVar("addressId")) {
    throw new Error("addressId missing — run customers/me/addresses/create first");
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("addressId", "");
  }
}

tests {
  test("HTTP 200 or 409 in active order", function () {
    expect([200, 409]).to.include(res.getStatus());
  });

  test("envelope", function () {
    const body = res.getBody();
    if (res.getStatus() === 200) {
      expect(body.success).to.equal(true);
      expect(body.data.message).to.include("deleted");
    } else {
      expect(body.error.code).to.equal("ADDRESS_IN_ACTIVE_ORDER");
    }
  });
}

docs {
  DELETE /api/v1/customers/me/addresses/:id — soft-delete; blocked if active order uses address.
  Errors: 401 UNAUTHORIZED, 404 ADDRESS_NOT_FOUND, 409 ADDRESS_IN_ACTIVE_ORDER
}

example {
  name: 200 OK
  description: Address soft-deleted successfully.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/addresses/8f14e45f-ceea-467a-9571-d2a0f3c8b9d1
    method: delete
    mode: none
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "message": "Address deleted successfully."
          }
        }
      '''
    }
  }
}

example {
  name: 409 ADDRESS_IN_ACTIVE_ORDER
  description: Address is tied to an order in PENDING, CONFIRMED, PACKED, or OUT_FOR_DELIVERY.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/addresses/8f14e45f-ceea-467a-9571-d2a0f3c8b9d1
    method: delete
    mode: none
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 409
      text: Conflict
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "ADDRESS_IN_ACTIVE_ORDER",
            "message": "Address is used by an order in PENDING, CONFIRMED, PACKED, or OUT_FOR_DELIVERY"
          }
        }
      '''
    }
  }
}
