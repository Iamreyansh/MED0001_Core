meta {
  name: set-default
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/customers/me/addresses/{{addressId}}/set-default
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
  if (!bru.getEnvVar("addressId")) {
    throw new Error("addressId missing — run customers/me/addresses/create first");
  }
}

script:post-response {
  const body = res.getBody();
  if (!(body && body.success && body.data)) {
    return;
  }
  if (body.data.id) {
    bru.setEnvVar("defaultAddressId", body.data.id);
  }
}

tests {
  test("HTTP 200 or 409 already default", function () {
    const status = res.getStatus();
    expect([200, 409]).to.include(status);
  });

  test("envelope", function () {
    const body = res.getBody();
    if (res.getStatus() === 200) {
      expect(body.success).to.equal(true);
      expect(body.data.is_default).to.equal(true);
    } else {
      expect(body.success).to.equal(false);
      expect(body.error.code).to.equal("ALREADY_DEFAULT");
    }
  });
}

docs {
  PATCH /api/v1/customers/me/addresses/:id/set-default — atomic default switch.
  Errors: 401 UNAUTHORIZED, 404 ADDRESS_NOT_FOUND, 409 ALREADY_DEFAULT
}

example {
  name: 200 OK
  description: Default address switched atomically.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/addresses/8f14e45f-ceea-467a-9571-d2a0f3c8b9d1/set-default
    method: patch
    mode: none
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "8f14e45f-ceea-467a-9571-d2a0f3c8b9d1",
            "is_default": true,
            "previous_default_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
            "message": "Default address updated."
          }
        }
      '''
    }
  }
}

example {
  name: 409 ALREADY_DEFAULT
  description: Address is already the customer's default.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/addresses/8f14e45f-ceea-467a-9571-d2a0f3c8b9d1/set-default
    method: patch
    mode: none
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 409
      text: Conflict
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "ALREADY_DEFAULT",
            "message": "This address is already the default"
          }
        }
      '''
    }
  }
}
