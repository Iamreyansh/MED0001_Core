meta {
  name: update
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/customers/me/addresses/{{addressId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "label": "HOME",
    "flat_building": "Flat 4B, Prestige Shantiniketan Tower 2",
    "area_locality": "Whitefield",
    "city": "Bengaluru",
    "state": "Karnataka",
    "pincode": "560066",
    "latitude": 12.9693,
    "longitude": 77.7499
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
  if (!bru.getEnvVar("addressId")) {
    throw new Error("addressId missing — run customers/me/addresses/create first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.id) {
    bru.setEnvVar("addressId", body.data.id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("success envelope with updated address", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.flat_building).to.include("Tower 2");
    expect(body.data.updated_at).to.be.a("string").that.is.not.empty;
  });
}

docs {
  PUT /api/v1/customers/me/addresses/:id — update address fields (not is_default).
  Errors: 400 VALIDATION_ERROR, 401 UNAUTHORIZED, 404 ADDRESS_NOT_FOUND
}

example {
  name: 200 OK
  description: Address fields updated; is_default unchanged.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/addresses/8f14e45f-ceea-467a-9571-d2a0f3c8b9d1
    method: put
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "label": "HOME",
        "flat_building": "Flat 4B, Prestige Shantiniketan Tower 2",
        "area_locality": "Whitefield",
        "city": "Bengaluru",
        "state": "Karnataka",
        "pincode": "560066",
        "latitude": 12.9693,
        "longitude": 77.7499
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "8f14e45f-ceea-467a-9571-d2a0f3c8b9d1",
            "label": "HOME",
            "flat_building": "Flat 4B, Prestige Shantiniketan Tower 2",
            "area_locality": "Whitefield",
            "city": "Bengaluru",
            "state": "Karnataka",
            "pincode": "560066",
            "latitude": 12.9693,
            "longitude": 77.7499,
            "is_default": true,
            "updated_at": "2026-07-26T10:05:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 404 ADDRESS_NOT_FOUND
  description: Address id does not exist or belongs to another customer.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/addresses/00000000-0000-4000-8000-000000000099
    method: put
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "label": "HOME",
        "flat_building": "Flat 4B",
        "area_locality": "Whitefield",
        "city": "Bengaluru",
        "state": "Karnataka",
        "pincode": "560066",
        "latitude": 12.9693,
        "longitude": 77.7499
      }
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "ADDRESS_NOT_FOUND",
            "message": "Address not found"
          }
        }
      '''
    }
  }
}
