meta {
  name: geocode
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/customers/me/addresses/geocode
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "latitude": 12.9716,
    "longitude": 77.5946
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
}

script:post-response {
  const body = res.getBody();
  if (!(body && body.success && body.data && body.data.suggested_address)) {
    return;
  }
  const s = body.data.suggested_address;
  if (s.pincode) {
    bru.setEnvVar("geocodePincode", s.pincode);
  }
  if (s.city) {
    bru.setEnvVar("geocodeCity", s.city);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("suggested address for Bengaluru pin", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.suggested_address.city).to.equal("Bengaluru");
    expect(body.data.suggested_address.pincode).to.be.a("string").that.is.not.empty;
  });
}

docs {
  POST /api/v1/customers/me/addresses/geocode — reverse geocode (cached 1h on lat,lng@4dp).
  Errors: 400 VALIDATION_ERROR, 401 UNAUTHORIZED, 502 GEOCODE_SERVICE_ERROR
}

example {
  name: 200 OK
  description: Reverse-geocoded suggestion for Bengaluru coordinates.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/addresses/geocode
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "latitude": 12.9716,
        "longitude": 77.5946
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "suggested_address": {
              "flat_building": "",
              "area_locality": "MG Road",
              "city": "Bengaluru",
              "state": "Karnataka",
              "pincode": "560001",
              "formatted_address": "MG Road, Bengaluru, Karnataka 560001, India",
              "latitude": 12.9716,
              "longitude": 77.5946
            }
          }
        }
      '''
    }
  }
}

example {
  name: 502 GEOCODE_SERVICE_ERROR
  description: Upstream geocoding provider failed or returned an error.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/addresses/geocode
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "latitude": 12.9716,
        "longitude": 77.5946
      }
    }
  }

  response: {
    status: {
      code: 502
      text: Bad Gateway
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "GEOCODE_SERVICE_ERROR",
            "message": "Google Maps API returned an error"
          }
        }
      '''
    }
  }
}
