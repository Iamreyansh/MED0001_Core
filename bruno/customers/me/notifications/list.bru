meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/customers/me/notifications?page=1&limit=20
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 20
  ~unread_only: true
  ~type: ORDER_UPDATE
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer verify-otp first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.notifications && body.data.notifications[0]) {
    bru.setEnvVar("inAppNotificationId", body.data.notifications[0].id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("notifications envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.notifications).to.be.an("array");
    expect(body.meta).to.have.property("page");
  });
}

docs {
  GET /api/v1/customers/me/notifications — inbox (excludes deleted + expired).
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/customers/me/notifications?unread_only=true&page=1&limit=20
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "notifications": [
              {
                "id": "n0000001-0000-4000-8000-000000000001",
                "type": "ORDER_UPDATE",
                "title": "Your order is out for delivery!",
                "body": "Ramesh Kumar is on the way. ETA: 12 minutes.",
                "action_url": "nmmedmate://order/uuid-order-1",
                "is_read": false,
                "can_delete": false,
                "created_at": "2026-07-24T08:14:22Z"
              }
            ]
          },
          "meta": { "page": 1, "limit": 20, "total": 14, "has_next": false }
        }
      '''
    }
  }
}
