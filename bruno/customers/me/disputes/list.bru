meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/customers/me/disputes?page=1&limit=20
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer verify-otp first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.disputes && body.data.disputes[0]) {
    bru.setEnvVar("supportDisputeUuid", body.data.disputes[0].id);
    bru.setEnvVar("supportDisputeId", body.data.disputes[0].dispute_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("list envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.disputes).to.be.an("array");
    expect(body.meta).to.have.property("page");
  });
}

docs {
  GET /api/v1/customers/me/disputes — own dispute history.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/customers/me/disputes?page=1&limit=20
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "disputes": [
              {
                "id": "dsp_uuid_001",
                "dispute_id": "DSP-20260724-000014",
                "order_id": "ord_uuid_001",
                "dispute_type": "WRONG_ITEMS",
                "status": "RESOLVED",
                "refund_amount_rs": 96,
                "refund_to": "SOURCE",
                "created_at": "2026-07-24T10:00:00Z",
                "resolved_at": "2026-07-24T11:00:00Z"
              }
            ]
          },
          "meta": { "page": 1, "limit": 20, "total": 1, "has_next": false }
        }
      '''
    }
  }
}
