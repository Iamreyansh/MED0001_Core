meta {
  name: get
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/customers/me/referral
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.referral_code) {
    bru.setEnvVar("myReferralCode", body.data.referral_code);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("success envelope with referral code", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.referral_code).to.be.a("string").that.has.lengthOf(7);
    expect(body.data.referral_link).to.include(body.data.referral_code);
    expect(body.data).to.have.property("share_message");
  });
}

docs {
  GET /api/v1/customers/me/referral — code, link, conversion stats.
  Rate limit: 30 req/min per user.
  Errors: 401 UNAUTHORIZED, 429 RATE_LIMITED
}

example {
  name: 200 OK
  description: Referral dashboard for the authenticated customer.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/referral
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "referral_code": "MEDRAM7",
            "referral_link": "https://namma-medmate.in/join?ref=MEDRAM7",
            "total_referrals": 5,
            "converted_referrals": 3,
            "pending_referrals": 1,
            "total_earned": 300.00,
            "pending_rewards": 100.00,
            "share_message": "Download Namma MedMate and get Rs 100 wallet credit on your first order! Use my referral code MEDRAM7. Link: https://namma-medmate.in/join?ref=MEDRAM7"
          }
        }
      '''
    }
  }
}
