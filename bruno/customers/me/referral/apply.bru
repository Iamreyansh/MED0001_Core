meta {
  name: apply
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/customers/me/referral/apply
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "referrer_code": "{{referrerCode}}"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
  if (!bru.getEnvVar("referrerCode")) {
    bru.setEnvVar("referrerCode", "MEDRAM7");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.referral_event_id) {
    bru.setEnvVar("referralEventId", body.data.referral_event_id);
  }
}

tests {
  // Seed expectation: set referralApplyExpectStatus (and optional referralApplyExpectCode) to the
  // outcome you seeded for. Defaults to the 200 happy path (fresh referee, valid referrer code).
  test("matches seeded outcome", function () {
    const expected = Number(bru.getEnvVar("referralApplyExpectStatus") || 200);
    expect(res.getStatus()).to.equal(expected);
  });

  test("envelope matches outcome", function () {
    const body = res.getBody();
    const expected = Number(bru.getEnvVar("referralApplyExpectStatus") || 200);
    if (expected === 200) {
      expect(body.success).to.equal(true);
      expect(body.data).to.have.property("referral_event_id");
      expect(body.data.status).to.equal("PENDING");
      expect(body.data.reward_amount).to.equal(100.0);
    } else {
      expect(body.success).to.equal(false);
      const expectedCode = bru.getEnvVar("referralApplyExpectCode");
      if (expectedCode) {
        expect(body.error.code).to.equal(expectedCode);
      } else {
        expect(body.error).to.have.property("code");
      }
    }
  });
}

docs {
  POST /api/v1/customers/me/referral/apply — apply code before first order.
  Rate limit: 5 req/hour per user.
  Set referralApplyExpectStatus / referralApplyExpectCode env vars to assert a seeded error path
  (defaults to the 200 happy path).
  Errors: 400 VALIDATION_ERROR, 401 UNAUTHORIZED, 404 REFERRAL_CODE_NOT_FOUND,
    409 REFERRAL_ALREADY_USED | FIRST_ORDER_ALREADY_PLACED, 422 SELF_REFERRAL_NOT_ALLOWED,
    429 RATE_LIMITED
}

example {
  name: 200 OK
  description: Referral code applied; reward pending first delivery.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/referral/apply
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "referrer_code": "MEDRAM7"
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "referral_event_id": "c3d4e5f6-a7b8-4901-c234-56789abcdef0",
            "referrer_code": "MEDRAM7",
            "status": "PENDING",
            "message": "Referral code applied! You and Ramesh will each receive Rs 100 wallet credit after your first order is delivered.",
            "reward_amount": 100.00
          }
        }
      '''
    }
  }
}

example {
  name: 422 SELF_REFERRAL_NOT_ALLOWED
  description: Customer applies their own code.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/referral/apply
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "referrer_code": "MEDSELF1"
      }
    }
  }

  response: {
    status: {
      code: 422
      text: Unprocessable Entity
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "SELF_REFERRAL_NOT_ALLOWED",
            "message": "Cannot apply your own referral code"
          }
        }
      '''
    }
  }
}

example {
  name: 404 REFERRAL_CODE_NOT_FOUND
  description: Well-formed code that maps to no customer.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/referral/apply
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "referrer_code": "MEDZZZZ"
      }
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "REFERRAL_CODE_NOT_FOUND",
            "message": "No customer with this referral code"
          }
        }
      '''
    }
  }
}

example {
  name: 409 REFERRAL_ALREADY_USED
  description: Referee has already applied a referral code.

  request: {
    url: {{baseUrl}}/api/v1/customers/me/referral/apply
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "referrer_code": "MEDRAM7"
      }
    }
  }

  response: {
    status: {
      code: 409
      text: Conflict
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "REFERRAL_ALREADY_USED",
            "message": "This customer has already applied a referral code"
          }
        }
      '''
    }
  }
}
