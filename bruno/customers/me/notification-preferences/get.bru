meta {
  name: get
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/customers/me/notification-preferences
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer verify-otp first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.customer_id) {
    bru.setEnvVar("customerId", body.data.customer_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("preferences envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.categories.order_updates.can_disable).to.equal(false);
    expect(body.data.categories.account_critical.can_disable).to.equal(false);
  });
}

docs {
  GET /api/v1/customers/me/notification-preferences — lazy-creates defaults.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/customers/me/notification-preferences
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "customer_id": "c0000001-0000-4000-8000-000000000001",
            "channels": {
              "push": { "enabled": true, "can_disable": true },
              "sms": { "enabled": true, "can_disable": true },
              "whatsapp": { "enabled": true, "can_disable": true },
              "email": { "enabled": true, "can_disable": true }
            },
            "categories": {
              "order_updates": { "enabled": true, "can_disable": false },
              "account_critical": { "enabled": true, "can_disable": false },
              "promotions": { "enabled": true, "can_disable": true },
              "refill_reminders": { "enabled": true, "can_disable": true },
              "offers": { "enabled": true, "can_disable": true }
            },
            "whatsapp_optout_active": false,
            "updated_at": "2026-08-11T08:00:00Z"
          }
        }
      '''
    }
  }
}
