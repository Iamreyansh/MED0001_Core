meta {
  name: get
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/customers/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
}

script:post-response {
  const body = res.getBody();
  if (!(body && body.success && body.data)) {
    return;
  }
  const data = body.data;
  if (data.id) {
    bru.setEnvVar("customerId", data.id);
  }
  if (data.phone) {
    bru.setEnvVar("customerPhone", data.phone);
  }
  console.log(`profile loaded; segment=${data.segment} flagged=${data.is_flagged}`);
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("success envelope with profile fields", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.id).to.be.a("string").that.is.not.empty;
    expect(body.data.phone).to.be.a("string").that.is.not.empty;
    expect(body.data.segment).to.be.a("string").that.is.not.empty;
    expect(body.data.is_flagged).to.be.a("boolean");
  });
}

docs {
  GET /api/v1/customers/me — own customer profile (phone, segment, wallet, loyalty). Writes `customerId` / `customerPhone` for admin calls.
  Errors: 401 UNAUTHORIZED
}

example {
  name: 200 OK
  description: Own profile with wallet balance and loyalty tier.

  request: {
    url: {{baseUrl}}/api/v1/customers/me
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
            "phone": "+919876543210",
            "name": "Ramesh Kumar",
            "avatar_url": "https://cdn.namma-medmate.in/avatars/ramesh.png",
            "date_of_birth": "1990-01-15",
            "gender": "MALE",
            "preferred_language": "kn",
            "segment": "REGULAR",
            "is_flagged": false,
            "wallet_balance": 125.00,
            "loyalty_points": 75,
            "loyalty_tier": "GOLD",
            "total_orders": 5,
            "created_at": "2026-07-25T10:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 401 UNAUTHORIZED
  description: Missing or invalid bearer token.

  request: {
    url: {{baseUrl}}/api/v1/customers/me
    method: get
    mode: none
  }

  response: {
    status: {
      code: 401
      text: Unauthorized
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "UNAUTHORIZED",
            "message": "Customer authentication required"
          }
        }
      '''
    }
  }
}
