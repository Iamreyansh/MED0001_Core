meta {
  name: get
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/schedule/medicines/{{scheduleMedicineId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
  if (!bru.getEnvVar("scheduleMedicineId")) {
    throw new Error("scheduleMedicineId missing — run schedule/medicines/create first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("detail envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.medicine_id).to.equal(bru.getEnvVar("scheduleMedicineId"));
    expect(body.data).to.have.property("approx_days_left");
    expect(body.data.today_doses).to.be.an("object");
  });
}

docs {
  GET /api/v1/schedule/medicines/:medicine_id
  Errors: 403 MEDICINE_ACCESS_DENIED; 404 MEDICINE_NOT_FOUND
}

example {
  name: 200 OK
  description: Medicine detail with approx_days_left.

  request: {
    url: {{baseUrl}}/api/v1/schedule/medicines/{{scheduleMedicineId}}
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "medicine_id": "b2c3d4e5-f6a7-4890-b123-456789abcdef",
            "member": {
              "member_id": "a1b2c3d4-e5f6-4789-a012-3456789abcde",
              "name": "Priya Sharma",
              "relationship": "SELF"
            },
            "medicine_name": "Metformin 500mg",
            "strength": "500mg",
            "dose": "1 tablet",
            "form": "TABLET",
            "dose_slots": [
              { "slot": "MORNING", "reminder_time": "08:00" },
              { "slot": "NIGHT", "reminder_time": "21:00" }
            ],
            "food_instruction": "AFTER",
            "duration_type": "ONGOING",
            "started_on_date": "2026-01-15",
            "ended_on_date": null,
            "condition_name": "Type 2 Diabetes",
            "prescribed_by": "Dr. Anil Sharma",
            "units_in_hand": 30,
            "refill_remind_at_units": 10,
            "approx_days_left": 15,
            "today_doses": { "total": 0, "taken": 0, "skipped": 0, "missed": 0, "upcoming": 0 },
            "course_progress_pct": null,
            "this_week_adherence_pct": null,
            "notes": "Take with breakfast",
            "is_active": true,
            "created_at": "2026-01-15T00:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 404 MEDICINE_NOT_FOUND
  description: Unknown medicine id.

  request: {
    url: {{baseUrl}}/api/v1/schedule/medicines/00000000-0000-4000-8000-000000000001
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 404
      text: Not Found
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "MEDICINE_NOT_FOUND",
            "message": "Medicine not found"
          }
        }
      '''
    }
  }
}
