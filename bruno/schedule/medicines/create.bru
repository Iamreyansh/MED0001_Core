meta {
  name: create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/schedule/medicines
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "medicine_name": "Metformin 500mg",
    "strength": "500mg",
    "dose": "1 tablet",
    "form": "TABLET",
    "dose_slots": [
      { "slot": "MORNING", "reminder_time": "08:00" },
      { "slot": "NIGHT", "reminder_time": "21:00" }
    ],
    "food_instruction": "AFTER",
    "duration_type": "ONGOING",
    "started_on_date": "2026-07-24",
    "condition_name": "Type 2 Diabetes",
    "prescribed_by_doctor": "Dr. Anil Sharma",
    "refill_units_in_hand": 30,
    "refill_remind_at_units": 10,
    "notes": "Take with breakfast"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.medicine_id) {
    bru.setEnvVar("scheduleMedicineId", body.data.medicine_id);
  }
  if (body && body.success && body.data && body.data.member_id) {
    bru.setEnvVar("scheduleSelfMemberId", body.data.member_id);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("create envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.medicine_id).to.be.a("string").that.is.not.empty;
    expect(body.data.reminders_scheduled).to.equal(14);
    expect(body.data.dose_slots).to.be.an("array").with.lengthOf(2);
  });
}

docs {
  POST /api/v1/schedule/medicines — add medicine (creates SELF member if missing).
  Errors: 400 MISSING_DURATION_DAYS, INVALID_REMINDER_TIME, TOO_MANY_DOSE_SLOTS;
  403 MEMBER_ACCESS_DENIED; 404 MEMBER_NOT_FOUND
}

example {
  name: 201 Created
  description: Medicine added with 2 slots → 14 reminders.

  request: {
    url: {{baseUrl}}/api/v1/schedule/medicines
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "medicine_name": "Metformin 500mg",
        "dose": "1 tablet",
        "form": "TABLET",
        "dose_slots": [
          { "slot": "MORNING", "reminder_time": "08:00" },
          { "slot": "NIGHT", "reminder_time": "21:00" }
        ],
        "food_instruction": "AFTER",
        "duration_type": "ONGOING",
        "started_on_date": "2026-07-24",
        "refill_units_in_hand": 30,
        "refill_remind_at_units": 10
      }
    }
  }

  response: {
    status: {
      code: 201
      text: Created
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "medicine_id": "b2c3d4e5-f6a7-4890-b123-456789abcdef",
            "medicine_name": "Metformin 500mg",
            "member_id": "a1b2c3d4-e5f6-4789-a012-3456789abcde",
            "dose_slots": [
              { "slot": "MORNING", "reminder_time": "08:00" },
              { "slot": "NIGHT", "reminder_time": "21:00" }
            ],
            "duration_type": "ONGOING",
            "started_on_date": "2026-07-24",
            "reminders_scheduled": 14,
            "created_at": "2026-07-24T07:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 400 MISSING_DURATION_DAYS
  description: DAYS without duration_days.

  request: {
    url: {{baseUrl}}/api/v1/schedule/medicines
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "medicine_name": "Amoxicillin",
        "dose": "1 capsule",
        "form": "CAPSULE",
        "dose_slots": [{ "slot": "MORNING", "reminder_time": "09:00" }],
        "food_instruction": "ANY",
        "duration_type": "DAYS",
        "started_on_date": "2026-07-24"
      }
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "MISSING_DURATION_DAYS",
            "message": "duration_days is required when duration_type is DAYS"
          }
        }
      '''
    }
  }
}

example {
  name: 400 TOO_MANY_DOSE_SLOTS
  description: More than 6 dose slots.

  request: {
    url: {{baseUrl}}/api/v1/schedule/medicines
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "medicine_name": "Too Many",
        "dose": "1",
        "form": "TABLET",
        "dose_slots": [
          { "slot": "CUSTOM", "reminder_time": "08:00" },
          { "slot": "CUSTOM", "reminder_time": "09:00" },
          { "slot": "CUSTOM", "reminder_time": "10:00" },
          { "slot": "CUSTOM", "reminder_time": "11:00" },
          { "slot": "CUSTOM", "reminder_time": "12:00" },
          { "slot": "CUSTOM", "reminder_time": "13:00" },
          { "slot": "CUSTOM", "reminder_time": "14:00" }
        ],
        "food_instruction": "ANY",
        "duration_type": "ONGOING",
        "started_on_date": "2026-07-24"
      }
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "TOO_MANY_DOSE_SLOTS",
            "message": "A medicine may have at most 6 dose slots"
          }
        }
      '''
    }
  }
}
