meta {
  name: refill
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/schedule/medicines/{{scheduleMedicineId}}/refill
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "units_added": 60,
    "refill_date": "2026-07-24"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
  if (!bru.getEnvVar("scheduleMedicineId")) {
    throw new Error("scheduleMedicineId missing — run schedule/medicines/create first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("refill envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.units_added).to.equal(60);
    expect(body.data).to.have.property("refill_alert_cleared");
  });
}

docs {
  POST /api/v1/schedule/medicines/:id/refill — additive refill.
  Errors: 400 INVALID_UNITS; 403 MEDICINE_ACCESS_DENIED; 404 MEDICINE_NOT_FOUND
}

example {
  name: 200 OK
  description: Manual refill clears alert.

  request: {
    url: {{baseUrl}}/api/v1/schedule/medicines/b2c3d4e5-f6a7-4890-b123-456789abcdef/refill
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "units_added": 60,
        "refill_date": "2026-07-24"
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "medicine_id": "b2c3d4e5-f6a7-4890-b123-456789abcdef",
            "medicine_name": "Metformin 500mg",
            "units_added": 60,
            "previous_units": 8,
            "new_units_in_hand": 68,
            "approx_days_left": 34,
            "refill_alert_cleared": true,
            "refill_date": "2026-07-24"
          }
        }
      '''
    }
  }
}

example {
  name: 400 INVALID_UNITS
  description: units_added must be > 0.

  request: {
    url: {{baseUrl}}/api/v1/schedule/medicines/b2c3d4e5-f6a7-4890-b123-456789abcdef/refill
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "units_added": 0
      }
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "INVALID_UNITS",
            "message": "units_added must be greater than 0"
          }
        }
      '''
    }
  }
}
