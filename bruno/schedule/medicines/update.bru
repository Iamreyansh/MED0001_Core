meta {
  name: update
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/schedule/medicines/{{scheduleMedicineId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "dose_slots": [
      { "slot": "MORNING", "reminder_time": "07:30" },
      { "slot": "NIGHT", "reminder_time": "21:30" }
    ],
    "refill_remind_at_units": 8
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
  if (!bru.getEnvVar("scheduleMedicineId")) {
    throw new Error("scheduleMedicineId missing — run schedule/medicines/create first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("update envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.medicine_id).to.equal(bru.getEnvVar("scheduleMedicineId"));
    expect(body.data.reminders_rescheduled).to.equal(true);
    expect(body.data.updated_fields).to.include("dose_slots");
  });
}

docs {
  PATCH /api/v1/schedule/medicines/:medicine_id — partial update; dose_slots change reschedules reminders.
}

example {
  name: 200 OK
  description: dose_slots updated → reminders recalculated.

  request: {
    url: {{baseUrl}}/api/v1/schedule/medicines/{{scheduleMedicineId}}
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "dose_slots": [
          { "slot": "MORNING", "reminder_time": "07:30" },
          { "slot": "NIGHT", "reminder_time": "21:30" }
        ],
        "refill_remind_at_units": 8
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "medicine_id": "b2c3d4e5-f6a7-4890-b123-456789abcdef",
            "updated_fields": ["dose_slots", "refill_remind_at_units"],
            "reminders_rescheduled": true,
            "updated_at": "2026-07-24T08:00:00Z"
          }
        }
      '''
    }
  }
}
