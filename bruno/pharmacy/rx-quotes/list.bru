meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/pharmacy/rx-quotes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/pharmacy/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && Array.isArray(body.data) && body.data[0]) {
    bru.setEnvVar("broadcastId", body.data[0].broadcast_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("incoming list", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.be.an("array");
  });
}

docs {
  GET /api/v1/pharmacy/rx-quotes — pending broadcasts for the active pharmacy.
}

example {
  name: 200 OK
  description: Pending response list
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/rx-quotes
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": [
            {
              "broadcast_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
              "patient_name": "Ravi Kumar",
              "distance_km": 1.2,
              "medicines_requested": ["Metformin 500mg (60)", "Glipizide 5mg (30)"],
              "received_at": "2026-07-24T11:00:00Z",
              "response_deadline": "2026-07-24T11:15:00Z",
              "time_remaining_seconds": 420,
              "status": "PENDING_RESPONSE"
            }
          ]
        }
      '''
    }
  }
}
