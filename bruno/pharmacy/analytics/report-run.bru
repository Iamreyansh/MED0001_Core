meta {
  name: report-run
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/pharmacy/analytics/reports/{{analyticsReportId}}?period=30D
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing");
  }
  if (!bru.getEnvVar("analyticsReportId")) {
    bru.setEnvVar("analyticsReportId", "SALES-REGISTER");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.export_url) {
    bru.setEnvVar("analyticsExportUrl", body.data.export_url);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("report envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("report_id");
    expect(body.data).to.have.property("columns");
  });
}

docs {
  GET /api/v1/pharmacy/analytics/reports/:report_id — optional export=excel|pdf. EPIC-016/STORY-004.
}

example {
  name: 200 OK inline
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/analytics/reports/SALES-REGISTER?period=30D
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "report_id": "SALES-REGISTER",
            "name": "Sales Register",
            "period_from": "2026-06-24",
            "period_to": "2026-07-24",
            "columns": ["invoice_number", "sale_date", "channel", "total_paise", "payment_method"],
            "rows": [],
            "totals": { "row_count": 0 },
            "export_url": null
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 404 REPORT_NOT_FOUND
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/analytics/reports/UNKNOWN?period=30D
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 404 text: Not Found }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": { "code": "REPORT_NOT_FOUND", "message": "report_id does not exist" }
        }
      '''
    }
  }
}
