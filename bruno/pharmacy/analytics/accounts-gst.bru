meta {
  name: accounts-gst
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/pharmacy/analytics/accounts-gst?period=30D
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — owner JWT required");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.gst_liability) {
    bru.setEnvVar("analyticsNetGst", String(body.data.gst_liability.net_payable_paise));
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("accounts-gst envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("pl_card");
    expect(body.data.gst_liability.slab_breakdown).to.be.an("array");
    expect(body.data.day_book).to.be.an("array");
  });
}

docs {
  GET /api/v1/pharmacy/analytics/accounts-gst — owner only. EPIC-016/STORY-004.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/analytics/accounts-gst?period=FY
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "pl_card": {
              "revenue_paise": 2840000,
              "cogs_paise": 2158000,
              "gross_profit_paise": 682000,
              "operating_expenses_paise": 0,
              "net_gst_payable_paise": 142000,
              "net_profit_paise": 540000
            },
            "gst_liability": {
              "output_gst_paise": 208000,
              "input_itc_paise": 66000,
              "net_payable_paise": 142000,
              "slab_breakdown": [
                { "slab_pct": 5, "taxable_value_paise": 0, "output_gst_paise": 0, "input_itc_paise": 0, "net_paise": 0 },
                { "slab_pct": 12, "taxable_value_paise": 0, "output_gst_paise": 0, "input_itc_paise": 0, "net_paise": 0 },
                { "slab_pct": 18, "taxable_value_paise": 0, "output_gst_paise": 0, "input_itc_paise": 0, "net_paise": 0 }
              ]
            },
            "cash_summary": {
              "total_collections_paise": 2840000,
              "cash_collected_paise": 520000,
              "digital_collected_paise": 2320000
            },
            "purchases_summary": {
              "total_purchases_paise": 2080000,
              "gst_on_purchases_paise": 66000
            },
            "day_book": []
          },
          "meta": {}
        }
      '''
    }
  }
}
