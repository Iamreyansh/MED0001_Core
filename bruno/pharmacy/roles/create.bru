meta {
  name: create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/pharmacy/roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "senior_pharmacist",
    "display_name": "Senior Pharmacist",
    "permissions": ["orders:fulfill", "inventory:*", "prescriptions:verify", "reports:read"]
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — pharmacy owner login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.id) {
    bru.setEnvVar("pharmacyCustomRoleId", body.data.id);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("custom role created", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.id).to.be.a("string").that.is.not.empty;
    expect(body.data.is_system).to.equal(false);
    expect(body.data.name).to.equal("senior_pharmacist");
  });
}

docs {
  POST /api/v1/pharmacy/roles — pharmacy_owner only.
  Errors: 400 VALIDATION_ERROR, 403 FORBIDDEN, 409 ROLE_NAME_CONFLICT
}

example {
  name: 201 Created
  description: Custom pharmacy role created.

  request: {
    url: {{baseUrl}}/api/v1/pharmacy/roles
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "name": "senior_pharmacist",
        "display_name": "Senior Pharmacist",
        "permissions": ["orders:fulfill", "inventory:*", "prescriptions:verify", "reports:read"]
      }
    }
  }

  response: {
    status: {
      code: 201
      text: Created
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "d4e5f6a7-b8c9-4012-d345-e6789012f345",
            "name": "senior_pharmacist",
            "display_name": "Senior Pharmacist",
            "is_system": false,
            "pharmacy_id": "c3d4e5f6-a7b8-4901-c234-d5678901ef23",
            "permissions": ["orders:fulfill", "inventory:*", "prescriptions:verify", "reports:read"],
            "created_at": "2026-07-26T10:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 409 ROLE_NAME_CONFLICT
  description: Role name already exists in this pharmacy.

  request: {
    url: {{baseUrl}}/api/v1/pharmacy/roles
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "name": "senior_pharmacist",
        "display_name": "Senior Pharmacist",
        "permissions": ["orders:fulfill", "inventory:*", "prescriptions:verify", "reports:read"]
      }
    }
  }

  response: {
    status: {
      code: 409
      text: Conflict
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "ROLE_NAME_CONFLICT",
            "message": "Role name already exists in this pharmacy"
          }
        }
      '''
    }
  }
}
