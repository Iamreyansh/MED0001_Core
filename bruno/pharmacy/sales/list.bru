meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/pharmacy/sales?from_date=2026-07-01&to_date=2026-07-24&page=1&limit=20
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.sales && body.data.sales.length) {
    bru.setEnvVar("saleId", body.data.sales[0].sale_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("ledger envelope with period_summary", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.period_summary).to.be.an("object");
    expect(body.data.sales).to.be.an("array");
    expect(body.meta).to.have.property("page");
  });
}

docs {
  GET /api/v1/pharmacy/sales
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/sales?from_date=2026-07-01&to_date=2026-07-24&page=1&limit=20
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "period_summary": {
              "from_date": "2026-07-01",
              "to_date": "2026-07-24",
              "bill_count": 486,
              "units_sold": 12400,
              "gross_revenue": 248600.00,
              "gst_collected": 22450.00,
              "net_collected": 226150.00,
              "credit_outstanding": 15400.00
            },
            "sales": [
              {
                "sale_id": "11111111-1111-4111-8111-111111111111",
                "invoice_number": "INV-2026-07-000042",
                "date": "2026-07-24T12:15:00Z",
                "channel": "COUNTER",
                "customer_name": "Priya Sharma",
                "grand_total": 450.00,
                "payment_status": "PAID"
              }
            ]
          },
          "meta": { "page": 1, "limit": 20, "total": 486, "has_next": true }
        }
      '''
    }
  }
}
