meta {
  name: get
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/pharmacy/inventory/{{inventoryProductId}}
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — login as pharmacy_owner or pharmacy_staff first");
  }
  if (!bru.getEnvVar("inventoryProductId")) {
    throw new Error("inventoryProductId missing — run list first (requires seeded pharmacy_product)");
  }
}

script:post-response {
  // no chaining vars
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("detail envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.id).to.be.a("string");
    expect(body.data.batches).to.be.an("array");
  });
}

docs {
  GET /api/v1/pharmacy/inventory/:product_id
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/inventory/11111111-2222-4333-8444-555555555555
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "11111111-2222-4333-8444-555555555555",
            "name": "Paracetamol 500mg Tab",
            "mrp": 22.50,
            "batches": [
              {
                "id": "22222222-3333-4444-8555-666666666666",
                "batch_number": "BN24001",
                "expiry_date": "2026-10-31",
                "quantity_current": 150,
                "is_active": true,
                "expiry_status": "EXPIRING_SOON"
              }
            ],
            "recent_movements": [],
            "units_sold_30d": 0,
            "days_of_cover": null
          },
          "meta": null
        }
      '''
    }
  }
}

example {
  name: 404 PRODUCT_NOT_FOUND
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/inventory/00000000-0000-4000-8000-000000000099
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 404 text: Not Found }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "PRODUCT_NOT_FOUND",
            "message": "Product not found"
          }
        }
      '''
    }
  }
}
