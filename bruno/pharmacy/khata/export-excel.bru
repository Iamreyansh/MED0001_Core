meta {
  name: export-excel
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/pharmacy/khata/payment-history?export=EXCEL
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing");
  }
}

script:post-response {
}

tests {
  test("HTTP 200 xlsx or PLAN_FEATURE_LOCKED", function () {
    expect([200, 403]).to.include(res.getStatus());
  });
}

docs {
  GET /api/v1/pharmacy/khata/payment-history?export=EXCEL
}

example {
  name: 200 OK Excel
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/khata/payment-history?export=EXCEL
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: text
      content: '''
        (binary xlsx)
      '''
    }
  }
}
