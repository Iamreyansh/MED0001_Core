meta {
  name: create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/pharmacy/purchases
  body: json
  auth: inherit
}

body:json {
  {
    "distributor_id": "{{distributorId}}",
    "invoice_number": "MED-BRUNO-001",
    "invoice_date": "2026-07-22"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — login as pharmacy_owner or pharmacy_staff first");
  }
  if (!bru.getEnvVar("distributorId")) {
    throw new Error("distributorId missing — create via POST /pharmacy/distributors (STORY-005)");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.grn_id) {
    bru.setEnvVar("grnId", body.data.grn_id);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("draft GRN created", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.status).to.equal("DRAFT");
    expect(body.data.line_count).to.equal(0);
  });
}

docs {
  POST /api/v1/pharmacy/purchases — create DRAFT GRN header.
}

example {
  name: 201 Created
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/purchases
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "distributor_id": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
        "invoice_number": "MED-2026-04521",
        "invoice_date": "2026-07-22"
      }
    }
  }
  response: {
    status: { code: 201 text: Created }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "grn_id": "11111111-2222-4333-8444-555555555555",
            "distributor_id": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
            "distributor_name": "Medico Pharma Distributors",
            "invoice_number": "MED-2026-04521",
            "invoice_date": "2026-07-22",
            "status": "DRAFT",
            "line_count": 0,
            "created_at": "2026-07-24T10:00:00Z"
          },
          "meta": null
        }
      '''
    }
  }
}

example {
  name: 400 DUPLICATE_INVOICE_NUMBER
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/purchases
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "distributor_id": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
        "invoice_number": "MED-2026-04521",
        "invoice_date": "2026-07-22"
      }
    }
  }
  response: {
    status: { code: 400 text: Bad Request }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "DUPLICATE_INVOICE_NUMBER",
            "message": "Invoice already exists for this distributor"
          }
        }
      '''
    }
  }
}
