meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/pharmacy/distributors?is_active=true&page=1&limit=20
  body: none
  auth: inherit
}

params:query {
  is_active: true
  page: 1
  limit: 20
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — login as pharmacy_owner or pharmacy_staff first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.distributors && body.data.distributors[0]) {
    bru.setEnvVar("distributorId", body.data.distributors[0].id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("list envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.kpi).to.be.an("object");
    expect(body.data.distributors).to.be.an("array");
    expect(body.meta).to.be.an("object");
  });
}

docs {
  GET /api/v1/pharmacy/distributors — Growth+ only. pharmacy_owner / pharmacy_staff.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/distributors?is_active=true&page=1&limit=20
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "kpi": {
              "distributor_count": 1,
              "products_sourced": 0,
              "outstanding_payable": 0.00,
              "on_credit_count": 1
            },
            "distributors": [
              {
                "id": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
                "firm_name": "Medico Pharma Distributors",
                "contact_name": "Ramesh Kumar",
                "phone": "+919876543210",
                "email": "ramesh@medicopharma.in",
                "gstin": "27AABCM1234A1Z5",
                "drug_licence_number": "DL-MH-2024-00123",
                "outstanding_payable": 0.00,
                "on_credit": true,
                "credit_limit": 100000.00,
                "payment_terms_days": 30,
                "is_active": true,
                "last_purchase_date": null
              }
            ]
          },
          "meta": { "page": 1, "limit": 20, "total": 1, "has_next": false }
        }
      '''
    }
  }
}

example {
  name: 403 PLAN_FEATURE_LOCKED
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/distributors
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 403 text: Forbidden }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "PLAN_FEATURE_LOCKED",
            "message": "Distributor management requires Growth plan or higher"
          }
        }
      '''
    }
  }
}
