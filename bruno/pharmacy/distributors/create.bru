meta {
  name: create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/pharmacy/distributors
  body: json
  auth: inherit
}

body:json {
  {
    "firm_name": "Medico Pharma Distributors",
    "contact_name": "Ramesh Kumar",
    "phone": "+919876543210",
    "email": "ramesh@medicopharma.in",
    "gstin": "27AABCM1234A1Z5",
    "drug_licence_number": "DL-MH-2024-00123",
    "address": "12 Industrial Estate, Mumbai",
    "payment_terms_days": 30,
    "credit_limit": 100000.00,
    "is_active": true
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — login as pharmacy_owner first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.id) {
    bru.setEnvVar("distributorId", body.data.id);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("created envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.id).to.be.a("string");
    expect(body.data.firm_name).to.equal("Medico Pharma Distributors");
  });
}

docs {
  POST /api/v1/pharmacy/distributors — pharmacy_owner, Growth+.
}

example {
  name: 201 Created
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/distributors
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "firm_name": "Medico Pharma Distributors",
        "phone": "+919876543210",
        "gstin": "27AABCM1234A1Z5",
        "payment_terms_days": 30,
        "credit_limit": 100000.00
      }
    }
  }
  response: {
    status: { code: 201 text: Created }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
            "firm_name": "Medico Pharma Distributors",
            "phone": "+919876543210",
            "gstin": "27AABCM1234A1Z5",
            "payment_terms_days": 30,
            "credit_limit": 100000.00,
            "is_active": true,
            "created_at": "2026-07-24T11:00:00Z"
          },
          "meta": null
        }
      '''
    }
  }
}

example {
  name: 400 INVALID_GSTIN_FORMAT
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/distributors
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "firm_name": "Medico Pharma Distributors",
        "phone": "+919876543210",
        "gstin": "INVALIDGSTIN"
      }
    }
  }
  response: {
    status: { code: 400 text: Bad Request }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "INVALID_GSTIN_FORMAT",
            "message": "GSTIN format is invalid"
          }
        }
      '''
    }
  }
}
