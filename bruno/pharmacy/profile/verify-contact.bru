meta {
  name: verify-contact
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/pharmacy/profile/verify-contact
  auth: inherit
  body: json
}

body:json {
  {
    "channel": "PHONE",
    "otp": "123456"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — login as pharmacy owner first");
  }
}

script:post-response {
}

tests {
  test("HTTP status", function () {
    expect(res.getStatus()).to.be.oneOf([200, 400, 404]);
  });
  test("envelope", function () {
    const body = res.getBody();
    expect(body).to.have.property("success");
    if (body.success) {
      expect(body.data.verified).to.equal(true);
    } else {
      expect(body.error).to.have.property("code");
    }
  });
}

docs {
  POST /api/v1/pharmacy/profile/verify-contact — apply pending phone/email after OTP.
  Magic OTP 123456 for test phones/emails (same pattern as registration).
}

example {
  name: 200 OK
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "pharmacy_id": "11111111-1111-4111-8111-111111111111",
            "channel": "PHONE",
            "verified": true,
            "message": "PHONE verified and updated successfully."
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 400 INVALID_OTP
  response: {
    status: { code: 400 }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "INVALID_OTP",
            "message": "Invalid OTP"
          }
        }
      '''
    }
  }
}
