meta {
  name: upload-logo
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/pharmacy/profile/logo
  auth: inherit
  body: multipart
}

body:multipart-form {
  file: @file(/path/to/shop.png)
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — login as pharmacy owner first");
  }
}

tests {
  test("HTTP 201", function () { expect(res.getStatus()).to.equal(201); });
  test("envelope", function () {
    const d = res.getBody().data;
    expect(res.getBody().success).to.equal(true);
    expect(d.logo_url).to.match(/^https?:\/\/.+\.(png|jpg|jpeg)$/i);
    expect(d.updated_fields).to.include("logo_url");
  });
}

docs {
  POST /api/v1/pharmacy/profile/logo — owner uploads a PNG or JPG (max 2 MB). Core stores the file and returns a public logo_url.
}

example {
  name: 201 Created
  response: {
    status: { code: 201 text: Created }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "logo_url": "http://localhost:8080/api/v1/public/pharmacy-logos/11111111-1111-4111-8111-111111111111.png",
            "updated_fields": ["logo_url"],
            "message": "Logo updated."
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 400 INVALID_LOGO
  response: {
    status: { code: 400 }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "INVALID_LOGO",
            "message": "Logo must be PNG or JPG"
          }
        }
      '''
    }
  }
}
