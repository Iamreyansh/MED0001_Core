meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/pharmacy/invoices?page=1&limit=20
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.invoices && body.data.invoices.length) {
    bru.setEnvVar("invoiceId", body.data.invoices[0].invoice_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("list envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.invoices).to.be.an("array");
    expect(body.meta).to.have.property("page");
  });
}

docs {
  GET /api/v1/pharmacy/invoices
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/invoices?page=1&limit=20
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "invoices": [
              {
                "invoice_id": "11111111-1111-4111-8111-111111111111",
                "invoice_number": "INV-2026-07-000042",
                "date": "2026-07-24",
                "customer_name": "Priya Sharma",
                "channel": "COUNTER",
                "payment_method": "CASH",
                "grand_total": 450.00,
                "payment_status": "PAID"
              }
            ]
          },
          "meta": { "page": 1, "limit": 20, "total": 1, "has_next": false }
        }
      '''
    }
  }
}
