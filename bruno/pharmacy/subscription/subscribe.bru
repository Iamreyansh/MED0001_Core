meta {
  name: subscribe
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/pharmacy/subscription/subscribe
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$uuid}}
}

body:json {
  {
    "plan_id": "{{crmStarterPlanId}}",
    "billing_cycle": "MONTHLY",
    "coupon_code": "SAAS20"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run pharmacy owner login first");
  }
  if (!bru.getEnvVar("crmStarterPlanId")) {
    bru.setEnvVar("crmStarterPlanId", "a1000000-0000-4000-8000-000000000002");
  }
  if (!bru.getRequestHeader("Idempotency-Key")) {
    bru.setHeader("Idempotency-Key", crypto.randomUUID());
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data) {
    bru.setEnvVar("crmSubscriptionId", body.data.subscription_id);
    bru.setEnvVar("crmInvoiceId", body.data.invoice_id);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("subscribe envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("subscription_id");
    expect(body.data).to.have.property("plan");
    expect(body.data).to.have.property("amount_charged_rs");
  });
}

docs {
  POST /api/v1/pharmacy/subscription/subscribe — pharmacy_owner subscribe to a plan.
  Idempotency-Key required (max 128). Replay returns the cached success body.
}

example {
  name: 201 Created
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/subscription/subscribe
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
      Idempotency-Key: 11111111-1111-4111-8111-111111111111
    }
    body:json: {
      {
        "plan_id": "a1000000-0000-4000-8000-000000000002",
        "billing_cycle": "MONTHLY",
        "coupon_code": "SAAS20"
      }
    }
  }
  response: {
    status: { code: 201 text: Created }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "subscription_id": "b1000000-0000-4000-8000-000000000001",
            "plan": "STARTER",
            "billing_cycle": "MONTHLY",
            "status": "ACTIVE",
            "renewal_date": "2026-08-24T10:00:00Z",
            "invoice_id": "c1000000-0000-4000-8000-000000000001",
            "amount_charged_rs": 699.00
          }
        }
      '''
    }
  }
}

example {
  name: 400 VALIDATION_ERROR missing Idempotency-Key
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/subscription/subscribe
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "plan_id": "a1000000-0000-4000-8000-000000000002",
        "billing_cycle": "MONTHLY"
      }
    }
  }
  response: {
    status: { code: 400 text: Bad Request }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Idempotency-Key is required"
          }
        }
      '''
    }
  }
}

example {
  name: 409 ALREADY_SUBSCRIBED
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/subscription/subscribe
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
      Idempotency-Key: 22222222-2222-4222-8222-222222222222
    }
    body:json: {
      {
        "plan_id": "a1000000-0000-4000-8000-000000000002",
        "billing_cycle": "MONTHLY"
      }
    }
  }
  response: {
    status: { code: 409 text: Conflict }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "ALREADY_SUBSCRIBED",
            "message": "Pharmacy already has an active subscription"
          }
        }
      '''
    }
  }
}
