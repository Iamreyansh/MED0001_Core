meta {
  name: accept
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/pharmacy/orders/{{orderId}}/accept
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/pharmacy/login first");
  }
  if (!bru.getEnvVar("orderId")) {
    throw new Error("orderId missing — run orders/place first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.order_id) {
    bru.setEnvVar("orderId", body.data.order_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("accepted envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.status).to.equal("ACCEPTED");
    expect(body.data).to.have.property("accepted_at");
  });
}

docs {
  POST /api/v1/pharmacy/orders/:order_id/accept — pharmacy accepts within 10 minutes.
}

example {
  name: 200 OK
  description: Accepted
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/orders/ordddddd-dddd-4ddd-8ddd-dddddddddddd/accept
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "order_id": "ordddddd-dddd-4ddd-8ddd-dddddddddddd",
            "order_number": "ORD-20260808-00001",
            "status": "ACCEPTED",
            "accepted_at": "2026-08-08T06:05:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 409 ORDER_ACCEPTANCE_TIMEOUT
  description: Window elapsed
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/orders/ordddddd-dddd-4ddd-8ddd-dddddddddddd/accept
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 409 text: Conflict }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "ORDER_ACCEPTANCE_TIMEOUT",
            "message": "10-minute acceptance window elapsed"
          }
        }
      '''
    }
  }
}
