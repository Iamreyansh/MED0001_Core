meta {
  name: get-cart
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/pharmacy/pos/cart/{{posCartId}}
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing");
  }
  if (!bru.getEnvVar("posCartId")) {
    throw new Error("posCartId missing — run create-cart first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("get cart envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.cart_id).to.equal(bru.getEnvVar("posCartId"));
    expect(body.data).to.have.property("applied_offers");
  });
}

docs {
  GET /api/v1/pharmacy/pos/cart/:cart_id
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/pos/cart/{{posCartId}}
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "cart_id": "11111111-1111-4111-8111-111111111111",
            "status": "ACTIVE",
            "items": [],
            "rx_items_present": false,
            "grand_total": 0.00,
            "applied_offers": []
          }
        }
      '''
    }
  }
}

example {
  name: 410 CART_EXPIRED
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/pos/cart/{{posCartId}}
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 410 text: Gone }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": { "code": "CART_EXPIRED", "message": "Cart has expired" }
        }
      '''
    }
  }
}
