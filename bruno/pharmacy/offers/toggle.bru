meta {
  name: toggle
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/pharmacy/offers/{{offerId}}/toggle
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing");
  }
  if (!bru.getEnvVar("offerId")) {
    throw new Error("offerId missing — run create first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect([200, 400, 404]).to.include(res.getStatus());
  });
  test("envelope", function () {
    const body = res.getBody();
    if (res.getStatus() === 200) {
      expect(body.success).to.equal(true);
      expect(body.data).to.have.property("is_active");
    }
  });
}

docs {
  PATCH /api/v1/pharmacy/offers/:offer_id/toggle — owner.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/offers/{{offerId}}/toggle
    method: patch
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "offer_id": "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee",
            "is_active": false,
            "toggled_at": "2026-07-24T14:15:00Z"
          }
        }
      '''
    }
  }
}
