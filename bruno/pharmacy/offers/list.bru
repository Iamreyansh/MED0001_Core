meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/pharmacy/offers?status=ACTIVE&page=1&limit=20
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.offers && body.data.offers.length) {
    bru.setEnvVar("offerId", body.data.offers[0].offer_id);
  }
}

tests {
  test("HTTP 200 or PLAN_FEATURE_LOCKED", function () {
    expect([200, 403]).to.include(res.getStatus());
  });
  test("envelope", function () {
    const body = res.getBody();
    if (res.getStatus() === 200) {
      expect(body.success).to.equal(true);
      expect(body.data.kpi).to.be.an("object");
      expect(body.data.offers).to.be.an("array");
    } else {
      expect(body.success).to.equal(false);
      expect(body.error.code).to.equal("PLAN_FEATURE_LOCKED");
    }
  });
}

docs {
  GET /api/v1/pharmacy/offers — Growth+, owner+staff.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/offers?status=ACTIVE&page=1&limit=20
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "kpi": { "active_count": 5, "total_redemptions": 284 },
            "offers": []
          },
          "meta": { "page": 1, "limit": 20, "total": 0, "has_next": false }
        }
      '''
    }
  }
}

example {
  name: 403 PLAN_FEATURE_LOCKED
  request: {
    url: {{baseUrl}}/api/v1/pharmacy/offers
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 403 text: Forbidden }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "PLAN_FEATURE_LOCKED",
            "message": "Offers require Growth plan or higher"
          }
        }
      '''
    }
  }
}
