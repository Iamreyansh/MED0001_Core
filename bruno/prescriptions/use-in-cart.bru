meta {
  name: use-in-cart
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/use-in-cart
  body: json
  auth: inherit
}

body:json {
  {
    "cart_id": "{{cartId}}"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
  if (!bru.getEnvVar("prescriptionId")) {
    throw new Error("prescriptionId missing — run prescriptions/upload first");
  }
  if (!bru.getEnvVar("cartId")) {
    throw new Error("cartId missing — run cart flow first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.cart_id) {
    bru.setEnvVar("cartId", body.data.cart_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("success envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.prescription_id).to.equal(bru.getEnvVar("prescriptionId"));
    expect(body.data.cart_id).to.be.a("string").that.is.not.empty;
    expect(body.data.message).to.equal("Prescription attached to cart");
  });
}

docs {
  POST /api/v1/prescriptions/:id/use-in-cart — attach to ACTIVE cart. Errors: PRESCRIPTION_EXPIRED, PRESCRIPTION_REJECTED, CART_NOT_FOUND, CART_PRESCRIPTION_MISMATCH.
}

example {
  name: 200 OK
  description: Prescription attached to cart.

  request: {
    url: {{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/use-in-cart
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "cart_id": "b2c3d4e5-f6a7-4890-9bcd-ef0123456789"
      }
    }
  }

  response: {
    status: {
      code: 200
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "cart_id": "b2c3d4e5-f6a7-4890-9bcd-ef0123456789",
            "prescription_id": "a1b2c3d4-e5f6-4789-8abc-def012345678",
            "prescription_status": "UPLOADED",
            "message": "Prescription attached to cart"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 422 PRESCRIPTION_EXPIRED
  description: Cannot attach expired prescription.

  request: {
    url: {{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/use-in-cart
    method: post
    body:json: {
      {
        "cart_id": "b2c3d4e5-f6a7-4890-9bcd-ef0123456789"
      }
    }
  }

  response: {
    status: {
      code: 422
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "PRESCRIPTION_EXPIRED",
            "message": "Prescription has passed its expiry date"
          }
        }
      '''
    }
  }
}
