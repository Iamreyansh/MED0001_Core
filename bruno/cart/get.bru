meta {
  name: get
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/cart
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
}

script:post-response {
  const body = res.getBody();
  if (!(body && body.success && body.data)) {
    return;
  }
  if (body.data.cart_id) {
    bru.setEnvVar("cartId", body.data.cart_id);
  }
  if (body.data.items && body.data.items[0] && body.data.items[0].item_id) {
    bru.setEnvVar("cartItemId", body.data.items[0].item_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("cart envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("cart_id");
    expect(body.data).to.have.property("bill");
  });
}

docs {
  GET /api/v1/cart — customer JWT; returns ACTIVE cart (creates empty if none).
}

example {
  name: 200 OK
  description: Active cart with bill.
  request: {
    url: {{baseUrl}}/api/v1/cart
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "cart_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
            "status": "ACTIVE",
            "pharmacy": null,
            "items": [],
            "coupon_applied": null,
            "coupon_discount": 0.00,
            "prescription_id": null,
            "prescription_status": null,
            "delivery_address": null,
            "bill": {
              "item_total": 0.00,
              "coupon_discount": 0.00,
              "subtotal_after_discount": 0.00,
              "delivery_fee": 0.00,
              "handling_fee": 0.00,
              "wallet_applied": 0.00,
              "total_payable": 0.00
            },
            "created_at": "2026-08-08T00:00:00Z",
            "updated_at": "2026-08-08T00:00:00Z"
          }
        }
      '''
    }
  }
}
