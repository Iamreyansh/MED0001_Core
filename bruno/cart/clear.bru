meta {
  name: clear
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/v1/cart
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("cleared message", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.message).to.equal("Cart cleared");
  });
}

docs {
  DELETE /api/v1/cart — clear items, pharmacy, coupon, prescription; status stays ACTIVE.
}

example {
  name: 200 OK
  description: Cart cleared.
  request: {
    url: {{baseUrl}}/api/v1/cart
    method: delete
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "message": "Cart cleared",
            "cart_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
            "status": "ACTIVE"
          }
        }
      '''
    }
  }
}
