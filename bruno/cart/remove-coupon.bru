meta {
  name: remove-coupon
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/api/v1/cart/coupon
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("coupon cleared", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.coupon_applied == null).to.equal(true);
  });
}

docs {
  DELETE /api/v1/cart/coupon — remove applied coupon; returns updated cart.
}

example {
  name: 200 OK
  description: Coupon removed.
  request: {
    url: {{baseUrl}}/api/v1/cart/coupon
    method: delete
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "cart_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
            "coupon_applied": null,
            "coupon_discount": 0.00
          }
        }
      '''
    }
  }
}
