meta {
  name: get
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
  if (!bru.getEnvVar("orderId")) {
    throw new Error("orderId missing — run orders/place first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.id) {
    bru.setEnvVar("orderId", body.data.id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("order detail envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("order_number");
    expect(body.data).to.have.property("bill");
    expect(body.data).to.have.property("payment");
  });
}

docs {
  GET /api/v1/orders/:order_id — customer own order only.
}

example {
  name: 200 OK
  description: Order detail
  request: {
    url: {{baseUrl}}/api/v1/orders/ordddddd-dddd-4ddd-8ddd-dddddddddddd
