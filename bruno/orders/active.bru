meta {
  name: active
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/orders/active
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && Array.isArray(body.data) && body.data.length > 0) {
    bru.setEnvVar("orderId", body.data[0].order_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("active envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.be.an("array");
  });
}

docs {
  GET /api/v1/orders/active — in-progress customer orders (non-terminal).
}

example {
  name: 200 OK
  description: Active orders list
  request: {
    url: {{baseUrl}}/api/v1/orders/active
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": [
            {
              "order_id": "ordddddd-dddd-4ddd-8ddd-dddddddddddd",
              "order_number": "ORD-20260724-00123",
              "pharmacy": { "name": "Sai Medicals" },
              "status": "OUT_FOR_DELIVERY",
              "items_count": 1,
              "total": 221.25,
              "eta_minutes": 7,
              "rider": {
                "name": "Suresh Kumar",
                "phone": "+91-9988776655",
                "vehicle_plate": "KA01AB1234"
              },
              "created_at": "2026-07-24T11:30:00Z",
              "estimated_delivery_at": "2026-07-24T11:52:00Z"
            }
          ]
        }
      '''
    }
  }
}
