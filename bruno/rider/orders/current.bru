meta {
  name: current
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/rider/orders/current
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — rider OTP login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.order_id) {
    bru.setEnvVar("orderId", body.data.order_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("current envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.order_id).to.be.a("string");
  });
}

docs {
  GET /api/v1/rider/orders/current — rider active assignment details.
}

example {
  name: 200 OK
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "order_id": "ordddddd-dddd-4ddd-8ddd-dddddddddddd",
            "order_number": "MED-20260724-001",
            "assignment_id": "assiiiii-iiii-4iii-8iii-iiiiiiiiiiii",
