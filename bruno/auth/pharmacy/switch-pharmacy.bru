meta {
  name: switch-pharmacy
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/pharmacy/switch-pharmacy
  body: json
  auth: bearer
}

auth:bearer {
  token: {{pharmacyAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "pharmacy_id": "{{pharmacyId}}"
  }
}

script:pre-request {
  const token = bru.getEnvVar("pharmacyAccessToken");
  if (!token) {
    console.warn("pharmacyAccessToken not set — run login first");
  }
  const pharmacyId = bru.getEnvVar("pharmacyId");
  if (!pharmacyId) {
    console.warn("pharmacyId not set — run login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data) {
    bru.setEnvVar("pharmacyAccessToken", body.data.access_token);
    console.log(`switched pharmacy, new accessToken saved`);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("success envelope with new access token", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.access_token).to.be.a("string").that.is.not.empty;
    expect(body.data.token_type).to.equal("Bearer");
    expect(body.data.active_pharmacy).to.be.an("object");
    expect(body.data.role_in_pharmacy).to.be.a("string");
  });
}

docs {
  POST /api/v1/auth/pharmacy/switch-pharmacy
  Bearer pharmacy_owner|pharmacy_staff. Switches active pharmacy context.
  Writes: pharmacyAccessToken (new).
  Errors: 400 VALIDATION_ERROR, 401 UNAUTHORIZED, 403 FORBIDDEN|POS_TOKEN_RESTRICTED, 404 PHARMACY_NOT_FOUND.
}

example {
  name: 200 OK
  description: Active pharmacy switched; new access token with updated pharmacy context.

  request: {
    url: {{baseUrl}}/api/v1/auth/pharmacy/switch-pharmacy
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{pharmacyAccessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "pharmacy_id": "c3d4e5f6-a7b8-9012-cdef-123456789012"
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "access_token": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJwaGFybWFjeSI6InN3aXRjaGVkIn0.fake-access",
            "token_type": "Bearer",
            "access_token_expires_in": 900,
            "active_pharmacy": {
              "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
              "name": "Sri Rama Pharmacy",
              "logo_url": null,
              "city": "Bengaluru",
              "subscription_plan": "GROWTH"
            },
            "role_in_pharmacy": "pharmacist"
          }
        }
      '''
    }
  }
}

example {
  name: 401 UNAUTHORIZED
  description: Missing or invalid bearer token.

  request: {
    url: {{baseUrl}}/api/v1/auth/pharmacy/switch-pharmacy
    method: post
    mode: json
    headers: {
      Content-Type: application/json
    }
    body:json: {
      {
        "pharmacy_id": "c3d4e5f6-a7b8-9012-cdef-123456789012"
      }
    }
  }

  response: {
    status: {
      code: 401
      text: Unauthorized
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "UNAUTHORIZED",
            "message": "Authentication required"
          }
        }
      '''
    }
  }
}
