meta {
  name: logout-all
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/logout-all
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — login first");
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("refreshToken", "");
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("sessions_revoked present", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.sessions_revoked).to.be.a("number");
  });
}

docs {
  POST /api/v1/auth/logout-all — soft-revoke all sessions for the authenticated user.
}

example {
  name: 200 OK
  description: All active sessions soft-revoked for the authenticated user.

  request: {
    url: {{baseUrl}}/api/v1/auth/logout-all
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "sessions_revoked": 2,
            "message": "All sessions have been terminated."
          }
        }
      '''
    }
  }
}

example {
  name: 401 UNAUTHORIZED
  description: Missing or invalid bearer token.

  request: {
    url: {{baseUrl}}/api/v1/auth/logout-all
    method: post
    mode: json
    headers: {
      Content-Type: application/json
    }
    body:json: {
      {}
    }
  }

  response: {
    status: {
      code: 401
      text: Unauthorized
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "UNAUTHORIZED",
            "message": "Authentication required"
          }
        }
      '''
    }
  }
}
