meta {
  name: revoke-session
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/v1/auth/sessions/{{sessionRowId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — login first");
  }
  if (!bru.getEnvVar("sessionRowId")) {
    throw new Error("sessionRowId missing — run auth/list-sessions first");
  }
}

script:post-response {
  // no-op
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("revoked message", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.session_id).to.be.a("string").that.is.not.empty;
    expect(body.data.message).to.equal("Session revoked.");
  });
}

docs {
  DELETE /api/v1/auth/sessions/:session_id — soft-revoke own session only (403 FORBIDDEN for another user's session). No admin cross-user endpoint in this story.
}
