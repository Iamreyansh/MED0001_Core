meta {
  name: send-otp
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/customer/send-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{phone}}",
    "device_info": {
      "platform": "bruno",
      "device_id": "{{deviceToken}}",
      "app_version": "local"
    }
  }
}

script:pre-request {
  const phone = bru.getEnvVar("phone") || "+919999900001";
  bru.setEnvVar("phone", phone);
  if (!bru.getEnvVar("deviceToken")) {
    bru.setEnvVar("deviceToken", "bruno-local-device");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.session_id) {
    bru.setEnvVar("sessionId", body.data.session_id);
    console.log(`sessionId=${body.data.session_id}`);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("success envelope with session_id", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.be.an("object");
    expect(body.data.session_id).to.be.a("string").that.is.not.empty;
    expect(body.data.phone).to.equal(bru.getEnvVar("phone"));
  });
}

docs {
  POST /api/v1/auth/customer/send-otp — start OTP session. Persists `sessionId` for verify-otp.
}
