meta {
  name: get
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/payments/{{paymentId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
  if (!bru.getEnvVar("paymentId")) {
    throw new Error("paymentId missing — run payments/initiate or verify first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.status) {
    bru.setEnvVar("paymentStatus", body.data.status);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("get envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.payment_id).to.be.a("string");
    expect(body.data.status).to.be.a("string");
  });
}

docs {
  GET /api/v1/payments/:payment_id — customer own payments or admin_finance/admin_super. Errors: PAYMENT_NOT_FOUND, FORBIDDEN.
}

example {
  name: 200 OK
  description: Payment detail
  request: {
    url: {{baseUrl}}/api/v1/payments/paymmmmm-mmmm-4mmm-8mmm-mmmmmmmmmmmm
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "payment_id": "paymmmmm-mmmm-4mmm-8mmm-mmmmmmmmmmmm",
            "order_id": "ordddddd-dddd-4ddd-8ddd-dddddddddddd",
            "customer_id": "custoooo-oooo-4ooo-8ooo-oooooooooooo",
            "amount": 495.00,
            "wallet_portion": 50.00,
            "gateway_portion": 445.00,
            "method": "UPI",
            "status": "CAPTURED",
            "razorpay_payment_id": "pay_XXXXXXXXXXXX",
            "razorpay_order_id": "order_XXXXXXXXXXXX",
            "gateway_fee": 8.91,
            "captured_at": "2026-07-24T13:15:00Z",
            "created_at": "2026-07-24T13:10:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 403 FORBIDDEN
  description: Cross-customer access denied
  request: {
    url: {{baseUrl}}/api/v1/payments/paymmmmm-mmmm-4mmm-8mmm-mmmmmmmmmmmm
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 403 text: Forbidden }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "FORBIDDEN",
            "message": "Cannot view another customer's payment"
          }
        }
      '''
    }
  }
}
