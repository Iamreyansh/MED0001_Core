meta {
  name: verify-upi
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/integrations/razorpay/verify-upi
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Internal-Token: {{internalServiceToken}}
}

body:json {
  {
    "vpa": "ravi.kumar@okicici"
  }
}

script:pre-request {
  // S2S token from Local.bru
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.vpa) {
    bru.setEnvVar("verifiedVpa", body.data.vpa);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("verify-upi envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.valid).to.equal(true);
    expect(body.data).to.have.property("name");
  });
}

docs {
  POST /api/v1/integrations/razorpay/verify-upi — S2S VPA validation.
}

example {
  name: 200 OK
  description: Valid VPA
  request: {
    url: {{baseUrl}}/api/v1/integrations/razorpay/verify-upi
    method: post
    mode: json
    headers: {
      X-Internal-Token: {{internalServiceToken}}
    }
    body:json: {
      {
        "vpa": "ravi.kumar@okicici"
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "vpa": "ravi.kumar@okicici",
            "valid": true,
            "name": "RAVI KUMAR"
          },
          "meta": {}
        }
      '''
    }
  }
}
