meta {
  name: webhook
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/integrations/razorpay/webhook
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Razorpay-Signature: {{razorpayWebhookSignature}}
}

body:json {
  {
    "entity": "event",
    "event": "payment.captured",
    "payload": {
      "payment": {
        "entity": {
          "id": "pay_xyz789",
          "order_id": "{{razorpayOrderId}}",
          "amount": 50400,
          "currency": "INR",
          "status": "captured",
          "method": "upi",
          "captured": true
        }
      }
    }
  }
}

script:pre-request {
  if (!bru.getEnvVar("razorpayOrderId")) {
    bru.setEnvVar("razorpayOrderId", "order_stub_local");
  }
  if (!bru.getEnvVar("razorpayWebhookSignature")) {
    bru.setEnvVar("razorpayWebhookSignature", "replace-with-hmac-of-raw-body");
  }
}

script:post-response {
  // no chained vars
}

tests {
  test("HTTP 200 or 400", function () {
    const status = res.getStatus();
    expect([200, 400]).to.include(status);
  });
  test("envelope", function () {
    const body = res.getBody();
    if (res.getStatus() === 200) {
      expect(body.success).to.equal(true);
    } else {
      expect(body.success).to.equal(false);
      expect(body.error.code).to.equal("INVALID_SIGNATURE");
    }
  });
}

docs {
  POST /api/v1/integrations/razorpay/webhook — public + HMAC. Errors: INVALID_SIGNATURE.
}

example {
  name: 200 OK
  description: Valid signature acknowledged
  request: {
    url: {{baseUrl}}/api/v1/integrations/razorpay/webhook
    method: post
    mode: json
    headers: {
      X-Razorpay-Signature: valid-hmac-hex
    }
    body:json: {
      {
        "event": "payment.captured",
        "payload": {
          "payment": {
            "entity": {
              "id": "pay_xyz789",
              "order_id": "order_abc123",
              "amount": 50400
            }
          }
        }
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true
        }
      '''
    }
  }
}

example {
  name: 400 INVALID_SIGNATURE
  description: Bad HMAC
  request: {
    url: {{baseUrl}}/api/v1/integrations/razorpay/webhook
    method: post
    mode: json
    headers: {
      X-Razorpay-Signature: deadbeef
    }
    body:json: {
      {
        "event": "payment.captured"
      }
    }
  }
  response: {
    status: { code: 400 text: Bad Request }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "INVALID_SIGNATURE",
            "message": "X-Razorpay-Signature verification failed"
          }
        }
      '''
    }
  }
}
