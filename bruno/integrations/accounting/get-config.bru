meta {
  name: get-config
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/integrations/accounting/config
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:pre-request {
  // pharmacy_owner JWT
}

script:post-response {
  // no-op
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("config envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("api_key_status");
    expect(body.data).to.have.property("pharmacy_id");
  });
}

docs {
  GET /api/v1/integrations/accounting/config — Auth: pharmacy_owner. Disconnected pharmacies return connected_system null + DISCONNECTED.
}

example {
  name: 200 OK disconnected
  description: No accounting system connected
  request: {
    url: {{baseUrl}}/api/v1/integrations/accounting/config
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "pharmacy_id": "11111111-1111-4111-8111-111111111111",
            "connected_system": null,
            "zoho_organization_id": null,
            "zoho_organization_name": null,
            "api_key_status": "DISCONNECTED",
            "last_sync_at": null,
            "last_sync_status": null,
            "auto_sync_enabled": false,
            "sync_frequency": null,
            "tally_xml_available": false
          },
          "meta": {}
        }
      '''
    }
  }
}
