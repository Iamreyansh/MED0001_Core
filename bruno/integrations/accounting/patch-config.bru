meta {
  name: patch-config
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/integrations/accounting/config
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "accounting_system": "ZOHO_BOOKS",
    "auto_sync_enabled": true,
    "sync_frequency": "DAILY"
  }
}

script:pre-request {
  // pharmacy_owner JWT
}

script:post-response {
  // no-op
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("patch-config envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("next_sync_at");
    expect(body.data.auto_sync_enabled).to.equal(true);
  });
}

docs {
  PATCH /api/v1/integrations/accounting/config — Auth: pharmacy_owner. DAILY sets next_sync_at to next 02:00 IST.
}

example {
  name: 200 OK
  description: Enable daily auto-sync
  request: {
    url: {{baseUrl}}/api/v1/integrations/accounting/config
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "accounting_system": "ZOHO_BOOKS",
        "auto_sync_enabled": true,
        "sync_frequency": "DAILY"
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "accounting_system": "ZOHO_BOOKS",
            "auto_sync_enabled": true,
            "sync_frequency": "DAILY",
            "next_sync_at": "2026-07-24T20:30:00Z",
            "updated_at": "2026-07-24T10:38:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}
