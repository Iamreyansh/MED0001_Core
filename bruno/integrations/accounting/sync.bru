meta {
  name: sync
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/integrations/accounting/sync
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "pharmacy_id": "{{pharmacyId}}",
    "accounting_system": "ZOHO_BOOKS",
    "sync_type": "SALES",
    "period_from": "2026-07-01",
    "period_to": "2026-07-31"
  }
}

script:pre-request {
  // pharmacy_owner JWT required (integrations/** is permitAll — controller enforces auth)
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.job_id) {
    bru.setEnvVar("accountingSyncJobId", body.data.job_id);
  }
}

tests {
  test("HTTP 202", function () {
    expect(res.getStatus()).to.equal(202);
  });
  test("sync envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("job_id");
    expect(body.data.status).to.equal("QUEUED");
  });
}

docs {
  POST /api/v1/integrations/accounting/sync — Trigger async sync. Auth: pharmacy_owner. Errors: PLAN_UPGRADE_REQUIRED, ACCOUNTING_NOT_CONFIGURED, INVALID_PERIOD, SYNC_IN_PROGRESS.
}

example {
  name: 202 Accepted
  description: Sync queued
  request: {
    url: {{baseUrl}}/api/v1/integrations/accounting/sync
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "pharmacy_id": "11111111-1111-4111-8111-111111111111",
        "accounting_system": "ZOHO_BOOKS",
        "sync_type": "SALES",
        "period_from": "2026-07-01",
        "period_to": "2026-07-31"
      }
    }
  }
  response: {
    status: { code: 202 text: Accepted }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "job_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
            "accounting_system": "ZOHO_BOOKS",
            "sync_type": "SALES",
            "period_from": "2026-07-01",
            "period_to": "2026-07-31",
            "status": "QUEUED",
            "estimated_records": 148,
            "queued_at": "2026-07-24T10:35:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 403 PLAN_UPGRADE_REQUIRED
  description: Free/Starter plan
  request: {
    url: {{baseUrl}}/api/v1/integrations/accounting/sync
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "pharmacy_id": "11111111-1111-4111-8111-111111111111",
        "accounting_system": "ZOHO_BOOKS",
        "sync_type": "SALES",
        "period_from": "2026-07-01",
        "period_to": "2026-07-31"
      }
    }
  }
  response: {
    status: { code: 403 text: Forbidden }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "PLAN_UPGRADE_REQUIRED",
            "message": "Accounting integration requires Growth plan or higher"
          }
        }
      '''
    }
  }
}
