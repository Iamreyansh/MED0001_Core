meta {
  name: sync-status
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/integrations/accounting/sync-status/{{accountingSyncJobId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:pre-request {
  // Uses accountingSyncJobId from sync.bru
}

script:post-response {
  // no-op
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("sync-status envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("job_id");
    expect(body.data).to.have.property("records_failed");
    expect(body.data).to.have.property("errors");
  });
}

docs {
  GET /api/v1/integrations/accounting/sync-status/:job_id — Auth: pharmacy_owner or admin_operations.
}

example {
  name: 200 OK
  description: Completed with partial failures
  request: {
    url: {{baseUrl}}/api/v1/integrations/accounting/sync-status/aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "job_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
            "accounting_system": "ZOHO_BOOKS",
            "sync_type": "SALES",
            "status": "COMPLETED",
            "records_processed": 148,
            "records_synced": 146,
            "records_failed": 2,
            "errors": [
              {
                "record_id": "uuid-invoice-42",
                "record_type": "SALES_INVOICE",
                "error_code": "INVALID_CUSTOMER_GSTIN",
                "error_message": "Customer GSTIN 27INVALID123 is not a valid GST number"
              }
            ],
            "started_at": "2026-07-24T10:35:05Z",
            "completed_at": "2026-07-24T10:36:22Z"
          },
          "meta": {}
        }
      '''
    }
  }
}
