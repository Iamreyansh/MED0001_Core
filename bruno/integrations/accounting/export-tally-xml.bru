meta {
  name: export-tally-xml
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/integrations/accounting/export-tally-xml?pharmacy_id={{pharmacyId}}&sync_type=SALES&period_from=2026-07-01&period_to=2026-07-31
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:pre-request {
  // pharmacy_owner JWT; pharmacyId from env
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.download_url) {
    bru.setEnvVar("tallyXmlDownloadUrl", body.data.download_url);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("export-tally-xml envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("download_url");
    expect(body.data).to.have.property("records_count");
    expect(body.data).to.have.property("tally_import_instructions");
  });
}

docs {
  GET /api/v1/integrations/accounting/export-tally-xml — Auth: pharmacy_owner. Generates Tally ENVELOPE/IMPORTDATA XML.
}

example {
  name: 200 OK
  description: Tally XML export
  request: {
    url: {{baseUrl}}/api/v1/integrations/accounting/export-tally-xml?pharmacy_id=11111111-1111-4111-8111-111111111111&sync_type=SALES&period_from=2026-07-01&period_to=2026-07-31
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "download_url": "https://s3.amazonaws.com/namma-medmate-exports/tally_xml_uuid-ph-1_20260724.xml?...",
            "file_size_kb": 184,
            "records_count": 148,
            "expires_at": "2026-07-31T10:40:00Z",
            "tally_import_instructions": "Open Tally > Gateway of Tally > Import Data > Vouchers. Select the downloaded XML file."
          },
          "meta": {}
        }
      '''
    }
  }
}
