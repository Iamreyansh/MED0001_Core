meta {
  name: verify
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/integrations/fssai/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Internal-Token: {{internalServiceToken}}
}

body:json {
  {
    "licence_number": "10019011001234"
  }
}

script:pre-request {
  // S2S FSSAI verify
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.licence_number) {
    bru.setEnvVar("lastFssaiLicence", body.data.licence_number);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("fssai envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("licence_number");
    expect(body.data).to.have.property("status");
  });
}

docs {
  POST /api/v1/integrations/fssai/verify — Errors: FSSAI_LICENCE_NOT_FOUND.
}

example {
  name: 200 OK
  description: FSSAI verified
  request: {
    url: {{baseUrl}}/api/v1/integrations/fssai/verify
    method: post
    mode: json
    headers: {
      X-Internal-Token: {{internalServiceToken}}
    }
    body:json: {
      {
        "licence_number": "10019011001234"
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "licence_number": "10019011001234",
            "valid": true,
            "business_name": "Apollo Health & Lifestyle Ltd",
            "category": "CENTRAL_LICENCE",
            "expiry_date": "2028-01-31",
            "is_expired": false,
            "status": "ACTIVE",
            "verified_at": "2026-07-24T10:23:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 422 FSSAI_LICENCE_NOT_FOUND
  description: Unknown licence
  request: {
    url: {{baseUrl}}/api/v1/integrations/fssai/verify
    method: post
    mode: json
    headers: {
      X-Internal-Token: {{internalServiceToken}}
    }
    body:json: {
      {
        "licence_number": "UNKNOWN-10019011001234"
      }
    }
  }
  response: {
    status: { code: 422 text: Unprocessable Entity }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "FSSAI_LICENCE_NOT_FOUND",
            "message": "FSSAI licence not found"
          }
        }
      '''
    }
  }
}
