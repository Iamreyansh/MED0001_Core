meta {
  name: verify-licence
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/integrations/drug-registry/verify-licence
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Internal-Token: {{internalServiceToken}}
}

body:json {
  {
    "licence_number": "KA/DRUG/2019/0042",
    "state": "Karnataka",
    "licence_type": "RETAIL"
  }
}

script:pre-request {
  // S2S drug licence verify
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data) {
    if (body.data.verification_id) {
      bru.setEnvVar("drugVerificationId", body.data.verification_id);
    }
    if (body.data.licence_number) {
      bru.setEnvVar("lastDrugLicence", body.data.licence_number);
    }
  }
}

tests {
  test("HTTP 200 or 202", function () {
    expect([200, 202]).to.include(res.getStatus());
  });
  test("drug envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("status");
  });
}

docs {
  POST /api/v1/integrations/drug-registry/verify-licence — sync 200 or async 202 PENDING.
}

example {
  name: 200 OK
  description: Synchronous verification
  request: {
    url: {{baseUrl}}/api/v1/integrations/drug-registry/verify-licence
    method: post
    mode: json
    headers: {
      X-Internal-Token: {{internalServiceToken}}
    }
    body:json: {
      {
        "licence_number": "KA/DRUG/2019/0042",
        "state": "Karnataka",
        "licence_type": "RETAIL"
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "licence_number": "KA/DRUG/2019/0042",
            "valid": true,
            "holder_name": "Apollo Pharmacy India Ltd",
            "issued_date": "2019-06-15",
            "expiry_date": "2028-07-24",
            "is_expired": false,
            "drugs_permitted": ["SCHEDULE_H", "SCHEDULE_H1", "OTC"],
            "state": "Karnataka",
            "licence_type": "RETAIL",
            "status": "ACTIVE",
            "cache_hit": false,
            "verified_at": "2026-07-24T10:22:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 202 Accepted
  description: Async pending poll
  request: {
    url: {{baseUrl}}/api/v1/integrations/drug-registry/verify-licence
    method: post
    mode: json
    headers: {
      X-Internal-Token: {{internalServiceToken}}
    }
    body:json: {
      {
        "licence_number": "OD/DRUG/2019/1",
        "state": "Odisha",
        "licence_type": "RETAIL"
      }
    }
  }
  response: {
    status: { code: 202 text: Accepted }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "verification_id": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee",
            "status": "PENDING",
            "poll_after_seconds": 30,
            "poll_url": "/api/v1/integrations/drug-registry/verification/aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
          },
          "meta": {}
        }
      '''
    }
  }
}
