meta {
  name: status
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/integrations/einvoice/status/{{lastIrn}}
  body: none
  auth: none
}

headers {
  X-Internal-Token: {{internalServiceToken}}
}

script:pre-request {
  // Requires lastIrn from generate-irn
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.irn) {
    bru.setEnvVar("lastIrn", body.data.irn);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("irn");
    expect(body.data).to.have.property("status");
  });
}

docs {
  GET /api/v1/integrations/einvoice/status/:irn — IRN status reconciliation. Error: IRN_NOT_FOUND.
}

example {
  name: 200 OK
  description: Active IRN status
  request: {
    url: {{baseUrl}}/api/v1/integrations/einvoice/status/a85e9a93af0ed3c3f1c7e2fd4b08e3a7f4c2a1b0c9d3e5f8a7b6c4d2e1f0a9b8
    method: get
    headers: {
      X-Internal-Token: {{internalServiceToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "irn": "a85e9a93af0ed3c3f1c7e2fd4b08e3a7f4c2a1b0c9d3e5f8a7b6c4d2e1f0a9b8",
            "status": "ACTIVE",
            "ack_number": "232410141234567",
            "ack_date": "2026-07-24T10:30:00Z",
            "seller_gstin": "29ABCDE1234F1ZW",
            "buyer_gstin": "27AAPFU0939F1ZV",
            "invoice_number": "INV-2026-07-001",
            "invoice_date": "2026-07-24",
            "total_invoice_value": 940.80,
            "generated_at": "2026-07-24T10:30:02Z",
            "cancelled_at": null
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 404 IRN_NOT_FOUND
  description: Unknown IRN
  request: {
    url: {{baseUrl}}/api/v1/integrations/einvoice/status/deadbeef00000000000000000000000000000000000000000000000000000000
    method: get
    headers: {
      X-Internal-Token: {{internalServiceToken}}
    }
  }
  response: {
    status: { code: 404 text: Not Found }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "IRN_NOT_FOUND",
            "message": "IRN not found in NIC portal"
          }
        }
      '''
    }
  }
}
