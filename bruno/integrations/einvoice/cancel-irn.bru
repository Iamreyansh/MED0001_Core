meta {
  name: cancel-irn
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/integrations/einvoice/cancel-irn
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Internal-Token: {{internalServiceToken}}
}

body:json {
  {
    "irn": "{{lastIrn}}",
    "cancel_reason_code": "1",
    "cancel_remark": "Invoice issued in error. Correct invoice will be issued separately."
  }
}

script:pre-request {
  // Requires lastIrn from generate-irn
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.irn) {
    bru.setEnvVar("lastIrn", body.data.irn);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("cancel-irn envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.status).to.equal("CANCELLED");
    expect(body.data).to.have.property("cancelled_at");
  });
}

docs {
  POST /api/v1/integrations/einvoice/cancel-irn — Cancel within 24h. Reason codes 1–4. Errors: IRN_CANCELLATION_WINDOW_EXPIRED, IRN_ALREADY_CANCELLED, IRN_NOT_FOUND.
}

example {
  name: 200 OK
  description: IRN cancelled
  request: {
    url: {{baseUrl}}/api/v1/integrations/einvoice/cancel-irn
    method: post
    mode: json
    headers: {
      X-Internal-Token: {{internalServiceToken}}
    }
    body:json: {
      {
        "irn": "a85e9a93af0ed3c3f1c7e2fd4b08e3a7f4c2a1b0c9d3e5f8a7b6c4d2e1f0a9b8",
        "cancel_reason_code": "1",
        "cancel_remark": "Invoice issued in error."
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "irn": "a85e9a93af0ed3c3f1c7e2fd4b08e3a7f4c2a1b0c9d3e5f8a7b6c4d2e1f0a9b8",
            "status": "CANCELLED",
            "cancel_reason_code": "1",
            "cancelled_at": "2026-07-24T11:00:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 422 IRN_CANCELLATION_WINDOW_EXPIRED
  description: More than 24 hours since generation
  request: {
    url: {{baseUrl}}/api/v1/integrations/einvoice/cancel-irn
    method: post
    mode: json
    headers: {
      X-Internal-Token: {{internalServiceToken}}
    }
    body:json: {
      {
        "irn": "a85e9a93af0ed3c3f1c7e2fd4b08e3a7f4c2a1b0c9d3e5f8a7b6c4d2e1f0a9b8",
        "cancel_reason_code": "1",
        "cancel_remark": "too late"
      }
    }
  }
  response: {
    status: { code: 422 text: Unprocessable Entity }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "IRN_CANCELLATION_WINDOW_EXPIRED",
            "message": "IRN can only be cancelled within 24 hours of generation"
          }
        }
      '''
    }
  }
}
