meta {
  name: payout
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/integrations/razorpayx/payout
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Internal-Token: {{internalServiceToken}}
}

body:json {
  {
    "fund_account_id": "{{razorpayxFundAccountId}}",
    "amount_paise": 4200000,
    "purpose": "payout",
    "reference_id": "PAYOUT-{{$timestamp}}",
    "notes": {
      "entity_type": "PHARMACY",
      "entity_id": "{{pharmacyId}}",
      "settlement_period": "2026-07-01 to 2026-07-15"
    }
  }
}

script:pre-request {
  if (!bru.getEnvVar("razorpayxFundAccountId")) {
    throw new Error("razorpayxFundAccountId missing — run integrations/razorpay/fund-account first");
  }
  if (!bru.getEnvVar("pharmacyId")) {
    bru.setEnvVar("pharmacyId", crypto.randomUUID());
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.razorpayx_payout_id) {
    bru.setEnvVar("razorpayxPayoutId", body.data.razorpayx_payout_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("payout envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("razorpayx_payout_id");
    expect(body.data.mode).to.equal("IMPS");
    expect(body.data.status).to.equal("processing");
  });
}

docs {
  POST /api/v1/integrations/razorpayx/payout — S2S payout. Auto IMPS ≤ 2e7 paise else NEFT. Errors: FUND_ACCOUNT_NOT_FOUND, INSUFFICIENT_BALANCE, RAZORPAYX_UNAVAILABLE.
}

example {
  name: 200 OK
  description: Payout initiated (IMPS auto)
  request: {
    url: {{baseUrl}}/api/v1/integrations/razorpayx/payout
    method: post
    mode: json
    headers: {
      X-Internal-Token: {{internalServiceToken}}
    }
    body:json: {
      {
        "fund_account_id": "fa_abc456",
        "amount_paise": 4200000,
        "purpose": "payout",
        "reference_id": "PAYOUT-2026-07-15-001",
        "notes": {
          "entity_type": "PHARMACY",
          "entity_id": "pharmaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"
        }
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "razorpayx_payout_id": "pout_def789",
            "fund_account_id": "fa_abc456",
            "amount_paise": 4200000,
            "mode": "IMPS",
            "status": "processing",
            "reference_id": "PAYOUT-2026-07-15-001",
            "initiated_at": "2026-07-24T10:15:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 422 FUND_ACCOUNT_NOT_FOUND
  description: Unknown fund account
  request: {
    url: {{baseUrl}}/api/v1/integrations/razorpayx/payout
    method: post
    mode: json
    headers: {
      X-Internal-Token: {{internalServiceToken}}
    }
    body:json: {
      {
        "fund_account_id": "fa_missing",
        "amount_paise": 1000,
        "reference_id": "PAYOUT-MISSING"
      }
    }
  }
  response: {
    status: { code: 422 text: Unprocessable Entity }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "FUND_ACCOUNT_NOT_FOUND",
            "message": "fund_account_id not found"
          }
        }
      '''
    }
  }
}
