meta {
  name: webhook
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/notifications/whatsapp/webhook
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Hub-Signature-256: {{waHubSignature}}
}

body:json {
  {
    "object": "whatsapp_business_account",
    "entry": [{
      "id": "WABA_ID",
      "changes": [{
        "value": {
          "messaging_product": "whatsapp",
          "statuses": [{
            "id": "{{waMessageId}}",
            "recipient_id": "919876543210",
            "status": "delivered",
            "timestamp": "1721808128"
          }]
        },
        "field": "messages"
      }]
    }]
  }
}

script:pre-request {
  if (!bru.getEnvVar("waMessageId")) {
    bru.setEnvVar("waMessageId", "wamid.abc123XYZ");
  }
  if (!bru.getEnvVar("waHubSignature")) {
    bru.setEnvVar("waHubSignature", "sha256=replace_with_hmac_of_raw_body");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success) {
    bru.setEnvVar("waWebhookOk", "true");
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("webhook envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
  });
}

docs {
  POST /api/v1/notifications/whatsapp/webhook — Meta callback; verify X-Hub-Signature-256 (HMAC-SHA256 app secret).
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/notifications/whatsapp/webhook
    method: post
    headers: {
      X-Hub-Signature-256: sha256=abcdef0123456789
      Content-Type: application/json
    }
    body:json: {
      {
        "object": "whatsapp_business_account",
        "entry": [{
          "changes": [{
            "value": {
              "statuses": [{
                "id": "wamid.abc123XYZ",
                "status": "delivered",
                "timestamp": "1721808128"
              }]
            },
            "field": "messages"
          }]
        }]
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": { "processed": true }
        }
      '''
    }
  }
}

example {
  name: 403 INVALID_SIGNATURE
  request: {
    url: {{baseUrl}}/api/v1/notifications/whatsapp/webhook
    method: post
    headers: {
      X-Hub-Signature-256: sha256=deadbeef
      Content-Type: application/json
    }
    body:json: {
      {
        "object": "whatsapp_business_account"
      }
    }
  }
  response: {
    status: { code: 403 text: Forbidden }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "INVALID_SIGNATURE",
            "message": "X-Hub-Signature-256 verification failed"
          }
        }
      '''
    }
  }
}
