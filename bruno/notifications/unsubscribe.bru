meta {
  name: unsubscribe
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/notifications/unsubscribe
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{emailUnsubscribeToken}}"
  }
}

script:pre-request {
  if (!bru.getEnvVar("emailUnsubscribeToken")) {
    throw new Error("emailUnsubscribeToken missing — send MARKETING email first (unsubscribe_url) or set token");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.email) {
    bru.setEnvVar("emailUnsubscribedAddress", body.data.email);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("unsubscribe envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.unsubscribed).to.equal(true);
  });
}

docs {
  POST /api/v1/notifications/unsubscribe — JWT token; disables email promotions + email_unsubscribes (STORY-005).
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/notifications/unsubscribe
    method: post
    headers: {
      Content-Type: application/json
    }
    body:json: {
      {
        "token": "eyJhbGciOiJIUzI1NiJ9.example"
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "unsubscribed": true,
            "email": "ravi.kumar@example.com",
            "message": "You have been unsubscribed from marketing emails. You will continue to receive order and account updates."
          }
        }
      '''
    }
  }
}

example {
  name: 410 TOKEN_EXPIRED
  request: {
    url: {{baseUrl}}/api/v1/notifications/unsubscribe
    method: post
    headers: {
      Content-Type: application/json
    }
    body:json: {
      {
        "token": "expired.jwt.token"
      }
    }
  }
  response: {
    status: { code: 410 text: Gone }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "TOKEN_EXPIRED",
            "message": "Unsubscribe token has expired"
          }
        }
      '''
    }
  }
}
