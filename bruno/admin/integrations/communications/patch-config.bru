meta {
  name: patch-config
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/admin/integrations/communications/config/SMS
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{adminAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "is_enabled": true,
    "provider": "MSG91",
    "fallback_provider": "TWILIO",
    "api_credentials": {
      "api_key": "new-msg91-api-key-here",
      "sender_id": "NMMATE"
    },
    "daily_send_limit": 50000
  }
}

script:pre-request {
  if (!bru.getEnvVar("adminAccessToken")) {
    throw new Error("adminAccessToken missing — run auth/admin/login first (admin_super)");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.api_key_preview) {
    bru.setEnvVar("commsApiKeyPreview", body.data.api_key_preview);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("envelope masked credentials", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.api_key_preview).to.match(/^\w{1,4}\*{4}$|^.{4}\*{4}$/);
    expect(body.data.connectivity_test_result).to.equal("PASSED");
    expect(JSON.stringify(body.data)).to.not.include("new-msg91-api-key-here");
  });
}

docs {
  PATCH /api/v1/admin/integrations/communications/config/:channel
  Auth: admin_super ONLY
  Errors: 403 FORBIDDEN, 404 CHANNEL_NOT_FOUND, 422 CONNECTIVITY_TEST_FAILED
}

example {
  name: 200 OK
  description: Credentials updated after connectivity test
  request: {
    url: {{baseUrl}}/api/v1/admin/integrations/communications/config/SMS
    method: patch
    headers: {
      Authorization: Bearer {{adminAccessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "is_enabled": true,
        "provider": "MSG91",
        "fallback_provider": "TWILIO",
        "api_credentials": {
          "api_key": "new-msg91-api-key-here",
          "sender_id": "NMMATE"
        },
        "daily_send_limit": 50000
      }
    }
  }
  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "channel": "SMS",
            "is_enabled": true,
            "provider": "MSG91",
            "fallback_provider": "TWILIO",
            "api_key_preview": "new-****",
            "daily_send_limit": 50000,
            "connectivity_test_result": "PASSED",
            "updated_by": "11111111-1111-4111-8111-111111111111",
            "updated_at": "2026-07-24T10:45:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 422 CONNECTIVITY_TEST_FAILED
  response: {
    status: {
      code: 422
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "CONNECTIVITY_TEST_FAILED",
            "message": "New credentials failed connectivity test"
          }
        }
      '''
    }
  }
}
