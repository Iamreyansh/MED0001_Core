meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/crm/addons
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && Array.isArray(body.data.addons) && body.data.addons.length) {
    const einv = body.data.addons.find(a => a.name === "E_INVOICE") || body.data.addons[0];
    bru.setEnvVar("crmAddonId", einv.addon_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("addons envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("addons");
    expect(body.data.addons[0]).to.have.property("attach_rate_pct");
    expect(body.data.addons[0]).to.have.property("mrr_rs");
  });
}

docs {
  GET /api/v1/admin/crm/addons — add-on catalogue with attach_rate_pct (EPIC-014/STORY-001).
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/crm/addons
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "addons": [
              {
                "addon_id": "a2000000-0000-4000-8000-000000000001",
                "name": "E_INVOICE",
                "price_monthly_rs": 199.00,
                "attach_rate_pct": 0.0,
                "mrr_rs": 0.00
              }
            ]
          }
        }
      '''
    }
  }
}
