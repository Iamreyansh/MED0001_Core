meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/crm/leads
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && Array.isArray(body.data.leads) && body.data.leads.length) {
    bru.setEnvVar("crmLeadId", body.data.leads[0].id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("leads envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("chips");
    expect(body.data).to.have.property("stage_funnel");
    expect(body.data).to.have.property("leads");
    expect(body.data.chips).to.have.property("weighted_forecast_mrr_rs");
  });
}

docs {
  GET /api/v1/admin/crm/leads — pipeline list + KPI chips (EPIC-014/STORY-004).
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/crm/leads
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "chips": {
              "open_leads": 148,
              "pipeline_mrr_rs": 184200.00,
              "weighted_forecast_mrr_rs": 52140.00,
              "avg_deal_mrr_rs": 1244.00,
              "win_rate_pct": 38.4,
              "avg_sales_cycle_days": 18
            },
            "stage_funnel": {
              "NEW": 32,
              "CONTACTED": 54,
              "DEMO": 38,
              "TRIAL": 24,
              "WON": 0
            },
            "leads": [
              {
                "id": "c4000000-0000-4000-8000-000000000001",
                "pharmacy_name": "Sri Ram Medical",
                "contact_name": "Ramesh Kumar",
                "phone": "+919876543210",
                "stage": "DEMO",
                "win_probability": 30,
                "estimated_mrr_rs": 1499.00,
                "source": "MARKETPLACE",
                "assigned_rep_id": "a0000000-0000-4000-8000-000000000002",
                "assigned_rep_name": "Sneha Rao",
                "created_at": "2026-07-10T09:00:00Z"
              }
            ]
          },
          "meta": { "page": 1, "limit": 20, "total": 148, "has_next": true }
        }
      '''
    }
  }
}
