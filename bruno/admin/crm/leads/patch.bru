meta {
  name: patch
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/admin/crm/leads/{{crmLeadId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "estimated_mrr_rs": 1499,
    "win_probability": 45,
    "notes": "Updated notes after follow-up call."
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("crmLeadId")) {
    throw new Error("crmLeadId missing — run admin/crm/leads/create first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.id) {
    bru.setEnvVar("crmLeadId", body.data.id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("patch envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("updated_at");
  });
}

docs {
  PATCH /api/v1/admin/crm/leads/:id — update assignment/MRR/notes (EPIC-014/STORY-004).
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/crm/leads/c4000000-0000-4000-8000-000000000001
    method: patch
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "estimated_mrr_rs": 1499,
        "win_probability": 45,
        "notes": "Updated notes after follow-up call."
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "c4000000-0000-4000-8000-000000000001",
            "updated_at": "2026-07-24T10:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 422 INVALID_REP
  request: {
    url: {{baseUrl}}/api/v1/admin/crm/leads/c4000000-0000-4000-8000-000000000001
    method: patch
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "assigned_rep_id": "00000000-0000-4000-8000-000000000099"
      }
    }
  }
  response: {
    status: { code: 422 text: Unprocessable Entity }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "INVALID_REP",
            "message": "assigned_rep_id not found"
          }
        }
      '''
    }
  }
}
