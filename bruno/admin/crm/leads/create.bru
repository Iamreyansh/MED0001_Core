meta {
  name: create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/crm/leads
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "pharmacy_name": "Sri Ram Medical",
    "contact_name": "Ramesh Kumar",
    "phone": "+919876543210",
    "email": "ramesh@srirammedical.com",
    "source": "REFERRAL",
    "target_plan": "STARTER",
    "estimated_mrr_rs": 699,
    "assigned_rep_id": "{{crmRepId}}"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.id) {
    bru.setEnvVar("crmLeadId", body.data.id);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("create envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("id");
    expect(body.data.stage).to.equal("NEW");
    expect(body.data.win_probability).to.equal(0);
  });
}

docs {
  POST /api/v1/admin/crm/leads — create lead at NEW (EPIC-014/STORY-004).
}

example {
  name: 201 Created
  request: {
    url: {{baseUrl}}/api/v1/admin/crm/leads
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "pharmacy_name": "Sri Ram Medical",
        "contact_name": "Ramesh Kumar",
        "phone": "+919876543210",
        "email": "ramesh@srirammedical.com",
        "source": "REFERRAL",
        "target_plan": "STARTER",
        "estimated_mrr_rs": 699
      }
    }
  }
  response: {
    status: { code: 201 text: Created }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "c4000000-0000-4000-8000-000000000002",
            "pharmacy_name": "Sri Ram Medical",
            "stage": "NEW",
            "win_probability": 0,
            "created_at": "2026-07-24T10:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 409 LEAD_ALREADY_EXISTS
  request: {
    url: {{baseUrl}}/api/v1/admin/crm/leads
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "pharmacy_name": "Sri Ram Medical",
        "contact_name": "Ramesh Kumar",
        "phone": "+919876543210",
        "source": "ORGANIC"
      }
    }
  }
  response: {
    status: { code: 409 text: Conflict }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "LEAD_ALREADY_EXISTS",
            "message": "Pharmacy already has an open lead"
          }
        }
      '''
    }
  }
}
