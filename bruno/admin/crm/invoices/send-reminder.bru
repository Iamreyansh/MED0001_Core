meta {
  name: send-reminder
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/admin/crm/invoices/{{crmInvoiceId}}/send-reminder
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("crmInvoiceId")) {
    throw new Error("crmInvoiceId missing — run admin/crm/invoices/list first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.sent_at) {
    bru.setEnvVar("crmReminderSentAt", body.data.sent_at);
  }
}

tests {
  test("HTTP 200 or 400", function () {
    expect([200, 400]).to.include(res.getStatus());
  });
  test("envelope", function () {
    const body = res.getBody();
    if (res.getStatus() === 200) {
      expect(body.success).to.equal(true);
      expect(body.data).to.have.property("reminder_sent_via");
    } else {
      expect(body.success).to.equal(false);
      expect(body.error.code).to.equal("INVOICE_ALREADY_PAID");
    }
  });
}

docs {
  POST /api/v1/admin/crm/invoices/:id/send-reminder — outbox EMAIL+WHATSAPP reminder.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/crm/invoices/11111111-1111-4111-8111-111111111111/send-reminder
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "invoice_id": "11111111-1111-4111-8111-111111111111",
            "reminder_sent_via": ["EMAIL", "WHATSAPP"],
            "sent_at": "2026-07-24T10:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 400 INVOICE_ALREADY_PAID
  request: {
    url: {{baseUrl}}/api/v1/admin/crm/invoices/11111111-1111-4111-8111-111111111111/send-reminder
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 400 text: Bad Request }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "INVOICE_ALREADY_PAID",
            "message": "Cannot send reminder on a PAID invoice"
          }
        }
      '''
    }
  }
}
