meta {
  name: mark-paid
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/admin/crm/invoices/{{crmInvoiceId}}/mark-paid
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{$uuid}}
}

body:json {
  {
    "payment_date": "2026-07-24",
    "payment_mode": "NEFT",
    "reference_number": "NEFT-TXN-20260724-001"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("crmInvoiceId")) {
    throw new Error("crmInvoiceId missing — run admin/crm/invoices/list first");
  }
  if (!bru.getRequestHeader("Idempotency-Key")) {
    bru.setHeader("Idempotency-Key", `crm-mark-paid-${Date.now()}`);
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.status) {
    bru.setEnvVar("crmInvoiceStatus", body.data.status);
  }
}

tests {
  test("HTTP 200 or 400", function () {
    expect([200, 400]).to.include(res.getStatus());
  });
  test("envelope", function () {
    const body = res.getBody();
    if (res.getStatus() === 200) {
      expect(body.success).to.equal(true);
      expect(body.data.status).to.equal("PAID");
      expect(body.data).to.have.property("subscription_status_updated_to");
    } else {
      expect(body.success).to.equal(false);
    }
  });
}

docs {
  POST /api/v1/admin/crm/invoices/:id/mark-paid — admin_super|admin_finance; Idempotency-Key required.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/crm/invoices/11111111-1111-4111-8111-111111111111/mark-paid
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Idempotency-Key: 33333333-3333-4333-8333-333333333333
    }
    body:json: {
      {
        "payment_date": "2026-07-24",
        "payment_mode": "NEFT",
        "reference_number": "NEFT-TXN-20260724-001"
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "invoice_id": "11111111-1111-4111-8111-111111111111",
            "status": "PAID",
            "paid_at": "2026-07-24T00:00:00Z",
            "marked_by": "44444444-4444-4444-8444-444444444444",
            "subscription_status_updated_to": "ACTIVE"
          }
        }
      '''
    }
  }
}
