meta {
  name: create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/campaigns
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Monsoon Reactivation - Dormant Users",
    "channel": "WHATSAPP",
    "segment_id": "{{segmentId}}",
    "message_template_id": "t0130003-0000-4000-8000-000000000001",
    "subject": null,
    "body": null,
    "cta_label": "Order Now",
    "cta_link": "https://app.nammamedmate.com/offers",
    "scheduled_at": "2026-07-25T10:00:00Z",
    "estimated_cost": 12400,
    "budget_cap": 15000
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("segmentId")) {
    bru.setEnvVar("segmentId", "a0130004-0000-4000-8000-000000000002");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.id) {
    bru.setEnvVar("campaignId", body.data.id);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("create envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.status).to.equal("SCHEDULED");
    expect(body.data.id).to.be.a("string");
  });
}

docs {
  POST /api/v1/admin/campaigns — create campaign (SCHEDULED if scheduled_at set else DRAFT).
}

example {
  name: 201 Created
  request: {
    url: {{baseUrl}}/api/v1/admin/campaigns
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "name": "Monsoon Reactivation - Dormant Users",
        "channel": "WHATSAPP",
        "segment_id": "a0130004-0000-4000-8000-000000000002",
        "message_template_id": "t0130003-0000-4000-8000-000000000001",
        "scheduled_at": "2026-07-25T10:00:00Z",
        "budget_cap": 15000
      }
    }
  }
  response: {
    status: { code: 201 text: Created }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "c0130003-0000-4000-8000-000000000001",
            "name": "Monsoon Reactivation - Dormant Users",
            "status": "SCHEDULED",
            "created_at": "2026-07-24T09:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 422 CHANNEL_TEMPLATE_REQUIRED
  request: {
    url: {{baseUrl}}/api/v1/admin/campaigns
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "name": "SMS blast",
        "channel": "SMS",
        "segment_id": "a0130004-0000-4000-8000-000000000002"
      }
    }
  }
  response: {
    status: { code: 422 text: Unprocessable Entity }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "CHANNEL_TEMPLATE_REQUIRED",
            "message": "SMS campaign requires message_template_id"
          }
        }
      '''
    }
  }
}
