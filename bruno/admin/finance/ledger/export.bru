meta {
  name: export
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/finance/ledger/export?from=2026-07-01&to=2026-07-31
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.download_url) {
    bru.setEnvVar("ledgerExportUrl", body.data.download_url);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("ledger export envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("download_url");
    expect(body.data).to.have.property("expires_at");
    expect(body.data).to.have.property("record_count");
    expect(body.data).to.have.property("from_date");
    expect(body.data).to.have.property("to_date");
    expect(body.data).to.have.property("generated_at");
  });
}

docs {
  GET /api/v1/admin/finance/ledger/export — CSV export download URL (max 90 days).
  Auth: admin_finance|admin_super. Errors: INVALID_DATE_RANGE, DATE_RANGE_TOO_LARGE.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/finance/ledger/export?from=2026-07-01&to=2026-07-31
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "download_url": "https://s3.amazonaws.com/medmate-exports/ledger_2026-07.csv",
            "expires_at": "2026-07-25T01:00:00Z",
            "record_count": 12450,
            "from_date": "2026-07-01",
            "to_date": "2026-07-31",
            "generated_at": "2026-07-24T16:30:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 422 DATE_RANGE_TOO_LARGE
  request: {
    url: {{baseUrl}}/api/v1/admin/finance/ledger/export?from=2026-01-01&to=2026-07-31
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 422 text: Unprocessable Entity }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "DATE_RANGE_TOO_LARGE",
            "message": "Range exceeds 90 days"
          }
        }
      '''
    }
  }
}
