meta {
  name: reconciliation-report
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/finance/cod-float/reconciliation-report?date=2026-07-24
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data) {
    bru.setEnvVar("codFloatReportDate", body.data.report_date);
  }
}

tests {
  test("HTTP 200 or 404", function () {
    expect([200, 404]).to.include(res.getStatus());
  });
  test("envelope", function () {
    const body = res.getBody();
    if (res.getStatus() === 200) {
      expect(body.success).to.equal(true);
      expect(body.data).to.have.property("rider_breakdown");
      expect(body.data).to.have.property("reconciliation_status");
    } else {
      expect(body.success).to.equal(false);
      expect(body.error.code).to.equal("REPORT_NOT_GENERATED");
    }
  });
}

docs {
  GET /api/v1/admin/finance/cod-float/reconciliation-report — daily COD recon (finance only).
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/finance/cod-float/reconciliation-report?date=2026-07-24
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "report_date": "2026-07-24",
            "total_cod_orders": 124,
            "total_cod_amount": 38500.00,
            "collected_by_riders": 38500.00,
            "deposited_to_platform": 35200.00,
            "outstanding_float": 3300.00,
            "variance": 0.00,
            "variance_reason": null,
            "reconciliation_status": "BALANCED",
            "rider_breakdown": [],
            "generated_at": "2026-07-24T17:30:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 404 REPORT_NOT_GENERATED
  request: {
    url: {{baseUrl}}/api/v1/admin/finance/cod-float/reconciliation-report?date=2026-01-01
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 404 text: Not Found }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "REPORT_NOT_GENERATED",
            "message": "Reconciliation job has not run for the requested date"
          }
        }
      '''
    }
  }
}
