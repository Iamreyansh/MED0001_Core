meta {
  name: remind
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/admin/finance/cod/{{codRiderId}}/remind
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "message": "You have Rs 2,850 in COD cash. Please deposit today to avoid order restrictions."
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing");
  }
  if (!bru.getEnvVar("codRiderId")) {
    throw new Error("codRiderId missing — run admin/finance/cod/list first");
  }
}

tests {
  test("HTTP 200 or 404", function () {
    expect([200, 404]).to.include(res.getStatus());
  });
  test("envelope", function () {
    const body = res.getBody();
    if (res.getStatus() === 200) {
      expect(body.success).to.equal(true);
      expect(body.data.notification_sent).to.equal(true);
      expect(body.data.sms_sent).to.equal(true);
    }
  });
}

docs {
  POST /api/v1/admin/finance/cod/:rider_id/remind — push + SMS deposit reminder.
}

example {
  name: 200 OK
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "rider_id": "a0000001-0000-4000-8000-0000000000r1",
            "notification_sent": true,
            "sms_sent": true,
            "sent_by": "a0000001-0000-4000-8000-0000000000a1",
            "sent_at": "2026-07-24T15:10:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}
