meta {
  name: patch
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/v1/admin/config
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "orders.delivery_fee": 30
  }
}

script:pre-request {
  if (!bru.getEnvVar("adminAccessToken")) {
    throw new Error("adminAccessToken missing — admin_super required");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && Array.isArray(body.data.updated_keys) && body.data.updated_keys.length) {
    bru.setEnvVar("platformConfigKey", body.data.updated_keys[0]);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.updated_count).to.be.a("number");
    expect(body.data.cache_invalidated).to.equal(true);
  });
}

docs {
  PATCH /api/v1/admin/config — bulk update (admin_super only). All-or-nothing transaction.
  Immutable keys in production → 422 CONFIG_KEY_IMMUTABLE (none updated).
  Errors: 400 VALIDATION_ERROR, 401 UNAUTHORIZED, 403 FORBIDDEN, 422 CONFIG_KEY_IMMUTABLE, 422 CONFIG_KEY_NOT_FOUND
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/config
    method: patch
    headers: {
      Authorization: Bearer {{adminAccessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "orders.delivery_fee": 30
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "updated_keys": ["orders.delivery_fee"],
            "updated_count": 1,
            "cache_invalidated": true,
            "effective_at": "2026-07-24T02:00:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 403 FORBIDDEN
  response: {
    status: { code: 403 }
    body: {
      type: json
      content: '''
        { "success": false, "error": { "code": "FORBIDDEN", "message": "Only admin_super can modify platform config" } }
      '''
    }
  }
}

example {
  name: 422 CONFIG_KEY_IMMUTABLE
  response: {
    status: { code: 422 }
    body: {
      type: json
      content: '''
        { "success": false, "error": { "code": "CONFIG_KEY_IMMUTABLE", "message": "One or more keys are immutable in production" } }
      '''
    }
  }
}
