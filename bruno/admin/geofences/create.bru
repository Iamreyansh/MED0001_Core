meta {
  name: create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/admin/geofences
  body: json
  auth: inherit
}

body:json {
  {
    "zone_id": "{{zoneId}}",
    "polygon_coordinates": [
      [12.9200, 77.6100],
      [12.9450, 77.6100],
      [12.9450, 77.6400],
      [12.9200, 77.6400],
      [12.9200, 77.6100]
    ]
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("zoneId")) {
    bru.setEnvVar("zoneId", "a0000001-0000-4000-8000-000000000001");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.geofence_id) {
    bru.setEnvVar("geofenceId", body.data.geofence_id);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("geofence envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("geofence_id");
    expect(body.data).to.have.property("area_sq_km");
  });
}

docs {
  POST /api/v1/admin/geofences — create zone geofence polygon (closed ring).
}

example {
  name: 201 Created
  request: {
    url: {{baseUrl}}/api/v1/admin/geofences
    method: post
    body:json: {
      {
        "zone_id": "a0000001-0000-4000-8000-000000000001",
        "polygon_coordinates": [
          [12.9200, 77.6100],
          [12.9450, 77.6100],
          [12.9450, 77.6400],
          [12.9200, 77.6400],
          [12.9200, 77.6100]
        ]
      }
    }
  }
  response: {
    status: { code: 201 text: Created }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "geofence_id": "d4e5f6a7-b8c9-0123-def0-234567890123",
            "zone_id": "a0000001-0000-4000-8000-000000000001",
            "zone_name": "Koramangala Zone",
            "polygon_coordinates": [[12.92, 77.61], [12.945, 77.61], [12.945, 77.64], [12.92, 77.64], [12.92, 77.61]],
            "area_sq_km": 4.8,
            "created_at": "2026-07-24T10:00:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 422 INVALID_POLYGON
  response: {
    status: { code: 422 }
    body: {
      type: json
      content: '''
        { "success": false, "error": { "code": "INVALID_POLYGON", "message": "Polygon not closed or has < 3 points" } }
      '''
    }
  }
}
