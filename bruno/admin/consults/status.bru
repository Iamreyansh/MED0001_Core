meta {
  name: status
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/admin/consults/{{consultId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

body:json {
  {
    "status": "IN_CALL",
    "notes": "Patient answered. Call in progress.",
    "is_advice_only": false,
    "clinical_notes": null
  }
}

script:pre-request {
  if (!bru.getEnvVar("adminAccessToken") && !bru.getEnvVar("accessToken")) {
    throw new Error("adminAccessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("adminAccessToken") && bru.getEnvVar("accessToken")) {
    bru.setEnvVar("adminAccessToken", bru.getEnvVar("accessToken"));
  }
  if (!bru.getEnvVar("consultId")) {
    throw new Error("consultId missing — run consults/request first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.consult_id) {
    bru.setEnvVar("consultId", body.data.consult_id);
  }
  if (body && body.success && body.data && body.data.status) {
    bru.setEnvVar("consultStatus", body.data.status);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status transition envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("previous_status");
    expect(body.data).to.have.property("status");
    expect(body.data).to.have.property("updated_at");
  });
}

docs {
  POST /api/v1/admin/consults/:id/status — strict state machine.
  COMPLETED requires e_prescription_id OR is_advice_only (body may set is_advice_only / clinical_notes).
  Errors: CONSULT_NOT_FOUND (404), INVALID_STATUS_TRANSITION (422), EPRESCRIPTION_REQUIRED (422).
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/consults/{{consultId}}/status
    method: post
    headers: {
      Authorization: Bearer {{adminAccessToken}}
    }
    body:json: {
      {
        "status": "IN_CALL",
        "notes": "Patient answered. Call in progress."
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "consult_id": "a1b2c3d4-e5f6-4789-8abc-def012345678",
            "status": "IN_CALL",
            "previous_status": "CALLING",
            "call_started_at": "2026-07-24T10:33:00Z",
            "updated_at": "2026-07-24T10:33:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 422 INVALID_STATUS_TRANSITION
  description: Skip REQUESTED → IN_CALL
  request: {
    url: {{baseUrl}}/api/v1/admin/consults/{{consultId}}/status
    method: post
    body:json: {
      {
        "status": "IN_CALL"
      }
    }
  }
  response: {
    status: { code: 422 }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "INVALID_STATUS_TRANSITION",
            "message": "Cannot transition from REQUESTED to IN_CALL"
          }
        }
      '''
    }
  }
}
