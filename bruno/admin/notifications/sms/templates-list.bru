meta {
  name: templates-list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/notifications/sms/templates?is_active=true
  body: none
  auth: inherit
}

params:query {
  is_active: true
  ~category: OTP
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.templates && body.data.templates[0]) {
    bru.setEnvVar("smsTemplateId", body.data.templates[0].template_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("templates envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.templates).to.be.an("array");
  });
}

docs {
  GET /api/v1/admin/notifications/sms/templates — admin_super; optional category / is_active filters.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/notifications/sms/templates?is_active=true
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "templates": [
              {
                "template_id": "OTP_VERIFICATION",
                "content": "Your Namma MedMate OTP is {{1}}. Valid for {{2}} minutes. Do not share with anyone. - NMMATE",
                "category": "OTP",
                "dlt_template_id": "1007164875432101",
                "sender_id": "NMMATE",
                "is_active": true,
                "created_at": "2026-01-15T10:00:00Z"
              }
            ]
          }
        }
      '''
    }
  }
}
