meta {
  name: logs
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/admin/notifications/sms/logs?template_id=OTP_VERIFICATION&page=1&limit=20
  body: none
  auth: inherit
}

params:query {
  template_id: OTP_VERIFICATION
  page: 1
  limit: 20
  ~to_phone: +919876543210
  ~status: SENT
  ~date_from: 2026-07-01T00:00:00Z
  ~date_to: 2026-07-31T23:59:59Z
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.logs && body.data.logs[0]) {
    bru.setEnvVar("smsLogId", body.data.logs[0].log_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("logs envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.logs).to.be.an("array");
    expect(body.meta).to.have.property("page");
  });
}

docs {
  GET /api/v1/admin/notifications/sms/logs — admin_super + admin_operations.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/notifications/sms/logs?template_id=OTP_VERIFICATION&page=1&limit=20
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "logs": [
              {
                "log_id": "a1000001-0000-4000-8000-000000000001",
                "to_phone": "+919876543210",
                "template_id": "OTP_VERIFICATION",
                "category": "OTP",
                "provider": "MSG91",
                "provider_message_id": "msg91-abc123",
                "fallback_used": false,
                "status": "DELIVERED",
                "cost_rs": 0.12,
                "sent_at": "2026-07-24T08:20:00Z",
                "delivered_at": "2026-07-24T08:20:04Z",
                "error_message": null
              }
            ]
          },
          "meta": { "page": 1, "limit": 20, "total": 1, "has_next": false }
        }
      '''
    }
  }
}
