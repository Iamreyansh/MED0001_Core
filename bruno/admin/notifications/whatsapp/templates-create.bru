meta {
  name: templates-create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/notifications/whatsapp/templates
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "REORDER_REMINDER",
    "category": "UTILITY",
    "language": "en",
    "body": "Hi {{1}}, it's time to reorder your {{2}}. You last ordered it {{3}} days ago. Tap below to reorder in one click!",
    "header": {
      "format": "TEXT",
      "text": "Medicine Refill Reminder"
    },
    "footer": "Reply STOP to opt out",
    "buttons": [
      { "type": "URL", "text": "Reorder Now", "url": "https://app.nammamedmate.in/reorder/{{1}}" }
    ]
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.template_name) {
    bru.setEnvVar("waTemplateName", body.data.template_name);
  }
}

tests {
  test("HTTP 202", function () {
    expect(res.getStatus()).to.equal(202);
  });
  test("pending template envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.status).to.equal("PENDING");
    expect(body.data).to.have.property("template_name");
  });
}

docs {
  POST /api/v1/admin/notifications/whatsapp/templates — admin_super; submit to Meta → 202 PENDING.
}

example {
  name: 202 Accepted
  request: {
    url: {{baseUrl}}/api/v1/admin/notifications/whatsapp/templates
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "name": "REORDER_REMINDER",
        "category": "UTILITY",
        "language": "en",
        "body": "Hi {{1}}, reorder {{2}}.",
        "header": { "format": "TEXT", "text": "Medicine Refill Reminder" },
        "footer": "Reply STOP to opt out",
        "buttons": [
          { "type": "URL", "text": "Reorder Now", "url": "https://app.nammamedmate.in/reorder/{{1}}" }
        ]
      }
    }
  }
  response: {
    status: { code: 202 text: Accepted }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "template_name": "REORDER_REMINDER",
            "status": "PENDING",
            "submitted_at": "2026-07-24T01:50:00Z",
            "estimated_review_days": 2
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 409 TEMPLATE_NAME_EXISTS
  request: {
    url: {{baseUrl}}/api/v1/admin/notifications/whatsapp/templates
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "name": "ORDER_CONFIRMED",
        "category": "UTILITY",
        "language": "en",
        "body": "dup"
      }
    }
  }
  response: {
    status: { code: 409 text: Conflict }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "TEMPLATE_NAME_EXISTS",
            "message": "template_name already registered"
          }
        }
      '''
    }
  }
}
