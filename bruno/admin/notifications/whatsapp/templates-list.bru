meta {
  name: templates-list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/notifications/whatsapp/templates
  body: none
  auth: inherit
}

params:query {
  ~category: UTILITY
  ~status: APPROVED
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.templates && body.data.templates[0]) {
    bru.setEnvVar("waTemplateName", body.data.templates[0].template_name);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("templates envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.templates).to.be.an("array");
  });
}

docs {
  GET /api/v1/admin/notifications/whatsapp/templates — admin_super; optional category / status filters.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/notifications/whatsapp/templates
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "templates": [
              {
                "template_name": "ORDER_CONFIRMED",
                "category": "UTILITY",
                "language": "en",
                "status": "APPROVED",
                "body_text": "Hi {{1}}, your order from {{2}} for {{3}} has been confirmed. Estimated delivery: {{4}}.",
                "buttons": [
                  { "type": "URL", "text": "Track Order", "url": "https://app.nammamedmate.in/track/{{1}}" }
                ],
                "last_used_at": "2026-07-24T08:22:00Z",
                "rejection_reason": null
              }
            ]
          },
          "meta": {}
        }
      '''
    }
  }
}
