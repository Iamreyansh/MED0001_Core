meta {
  name: templates-list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/notifications/email/templates
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.templates && body.data.templates[0]) {
    bru.setEnvVar("emailTemplateId", body.data.templates[0].id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("templates envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.templates).to.be.an("array");
    if (body.data.templates.length > 0) {
      expect(body.data.templates[0]).to.have.property("open_rate_pct");
      expect(body.data.templates[0]).to.have.property("click_rate_pct");
    }
  });
}

docs {
  GET /api/v1/admin/notifications/email/templates — admin_super; includes open/click rates.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/notifications/email/templates
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "templates": [
              {
                "id": "ORDER_CONFIRMATION",
                "name": "Order Confirmation",
                "subject": "Your Namma MedMate order #{{order_id}} is confirmed!",
                "category": "TRANSACTIONAL",
                "last_sent": "2026-07-24T08:25:00Z",
                "open_rate_pct": 68.4,
                "click_rate_pct": 24.1
              }
            ]
          }
        }
      '''
    }
  }
}
