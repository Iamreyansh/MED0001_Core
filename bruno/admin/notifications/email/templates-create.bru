meta {
  name: templates-create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/notifications/email/templates
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Refund Processed",
    "template_id": "REFUND_PROCESSED",
    "subject": "Refund of {{amount}} processed for order #{{order_id}}",
    "html_body": "<p>Hi {{customer_name}}, refund {{amount}} for {{order_id}}.</p>",
    "text_body": "Hi {{customer_name}}, refund {{amount}} for {{order_id}}.",
    "category": "TRANSACTIONAL"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.template_id) {
    bru.setEnvVar("emailTemplateId", body.data.template_id);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("create envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("template_id");
    expect(body.data).to.have.property("category");
  });
}

docs {
  POST /api/v1/admin/notifications/email/templates — create or update (admin_super).
}

example {
  name: 201 Created
  request: {
    url: {{baseUrl}}/api/v1/admin/notifications/email/templates
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "name": "Refund Processed",
        "template_id": "REFUND_PROCESSED",
        "subject": "Refund of {{amount}} processed for order #{{order_id}}",
        "html_body": "<p>Hi {{customer_name}}, refund {{amount}}.</p>",
        "text_body": "Hi {{customer_name}}, refund {{amount}}.",
        "category": "TRANSACTIONAL"
      }
    }
  }
  response: {
    status: { code: 201 text: Created }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "template_id": "REFUND_PROCESSED",
            "category": "TRANSACTIONAL",
            "created_at": "2026-07-24T01:55:00Z"
          }
        }
      '''
    }
  }
}
