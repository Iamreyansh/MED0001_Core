meta {
  name: list-by-category
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/automation/triggers?category=DISPATCH
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("DISPATCH filter", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    body.data.triggers.forEach((t) => expect(t.category).to.equal("DISPATCH"));
  });
}

docs {
  GET /api/v1/admin/automation/triggers?category=DISPATCH
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/automation/triggers?category=DISPATCH
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "triggers": [
              {
                "trigger_id": "order_unassigned",
                "category": "DISPATCH",
                "name": "Order Unassigned",
                "description": "Fires when an order has been placed but no rider assigned for N minutes.",
                "parameters": [],
                "available_conditions": ["zone_in"],
                "available_context_vars": ["order.id"]
              }
            ],
            "total_triggers": 3
          },
          "meta": {}
        }
      '''
    }
  }
}
