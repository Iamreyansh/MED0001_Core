meta {
  name: toggle
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/admin/automation/workflows/{{automationWorkflowId}}/toggle
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "ACTIVE"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("automationWorkflowId")) {
    throw new Error("automationWorkflowId missing — run workflows/create first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status updated", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.status).to.equal("ACTIVE");
  });
}

docs {
  POST /api/v1/admin/automation/workflows/:id/toggle — admin_super only.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/automation/workflows/11111111-1111-4111-8111-111111111111/toggle
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "status": "ACTIVE"
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "11111111-1111-4111-8111-111111111111",
            "status": "ACTIVE",
            "updated_at": "2026-07-24T09:22:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 403 FORBIDDEN
  request: {
    url: {{baseUrl}}/api/v1/admin/automation/workflows/11111111-1111-4111-8111-111111111111/toggle
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "status": "ACTIVE"
      }
    }
  }
  response: {
    status: { code: 403 text: Forbidden }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "FORBIDDEN",
            "message": "Only admin_super can toggle workflows"
          }
        }
      '''
    }
  }
}
