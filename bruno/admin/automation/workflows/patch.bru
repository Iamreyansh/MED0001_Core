meta {
  name: patch
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/admin/automation/workflows/{{automationWorkflowId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "description": "Updated description"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("automationWorkflowId")) {
    throw new Error("automationWorkflowId missing — run workflows/create first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("paused + versioned", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("active_executions_paused");
    expect(body.data).to.have.property("version");
    expect(body.data.status).to.equal("INACTIVE");
  });
}

docs {
  PATCH /api/v1/admin/automation/workflows/:id — pauses active executions, increments version.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/automation/workflows/11111111-1111-4111-8111-111111111111
    method: patch
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "description": "Updated"
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "11111111-1111-4111-8111-111111111111",
            "version": 2,
            "active_executions_paused": 4,
            "status": "INACTIVE",
            "updated_at": "2026-07-24T09:20:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}
