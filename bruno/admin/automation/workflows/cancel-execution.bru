meta {
  name: cancel-execution
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/admin/automation/workflows/{{automationWorkflowId}}/executions/{{automationExecutionId}}/cancel
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("automationWorkflowId") || !bru.getEnvVar("automationExecutionId")) {
    throw new Error("automationWorkflowId/automationExecutionId missing");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("cancelled", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.status).to.equal("CANCELLED");
  });
}

docs {
  POST /api/v1/admin/automation/workflows/:id/executions/:executionId/cancel — AC-008.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/automation/workflows/11111111-1111-4111-8111-111111111111/executions/33333333-3333-4333-8333-333333333333/cancel
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "execution_id": "33333333-3333-4333-8333-333333333333",
            "status": "CANCELLED",
            "cancelled_at": "2026-07-24T09:30:00Z",
            "current_step": "s3",
            "step_history": [
              { "step_id": "s1", "type": "ACTION", "executed_at": "2026-07-17T10:00:00Z" }
            ]
          },
          "meta": {}
        }
      '''
    }
  }
}
