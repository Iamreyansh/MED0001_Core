meta {
  name: get
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/admin/automation/workflows/{{automationWorkflowId}}
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("automationWorkflowId")) {
    throw new Error("automationWorkflowId missing — run workflows/create or list first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("detail has steps", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("steps");
    expect(body.data).to.have.property("stats");
  });
}

docs {
  GET /api/v1/admin/automation/workflows/:id — workflow detail + stats.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/automation/workflows/11111111-1111-4111-8111-111111111111
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "11111111-1111-4111-8111-111111111111",
            "name": "DUNNING_LADDER",
            "status": "ACTIVE",
            "version": 1,
            "steps": [
              {
                "step_id": "s1",
                "type": "ACTION",
                "action_id": "send_notification",
                "params": { "template": "INVOICE_OVERDUE_DAY0" },
                "next_step_id_on_true": "s2",
                "next_step_id_on_false": null
              }
            ],
            "stats": {
              "active_executions": 4,
              "completed_all_time": 142,
              "cancelled_all_time": 12,
              "avg_completion_hours": 168
            }
          },
          "meta": {}
        }
      '''
    }
  }
}
