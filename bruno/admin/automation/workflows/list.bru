meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/automation/workflows
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && Array.isArray(body.data.workflows) && body.data.workflows[0]) {
    bru.setEnvVar("automationWorkflowId", body.data.workflows[0].id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("workflows envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("workflows");
  });
}

docs {
  GET /api/v1/admin/automation/workflows — list workflows.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/automation/workflows
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "workflows": [
              {
                "id": "11111111-1111-4111-8111-111111111111",
                "name": "DUNNING_LADDER",
                "description": "Progressive dunning",
                "trigger_id": "invoice_overdue",
                "steps_count": 7,
                "active_executions": 4,
                "completed_today": 2,
                "status": "ACTIVE",
                "version": 1,
                "created_at": "2026-01-01T00:00:00Z"
              }
            ]
          },
          "meta": {}
        }
      '''
    }
  }
}
