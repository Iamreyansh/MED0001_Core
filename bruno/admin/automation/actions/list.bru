meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/automation/actions
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && Array.isArray(body.data.actions) && body.data.actions.length) {
    bru.setEnvVar("automationActionId", body.data.actions[0].action_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("actions envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.total_actions).to.be.at.least(16);
    const byId = Object.fromEntries(body.data.actions.map((a) => [a.action_id, a]));
    expect(byId.suspend_entity.always_require_approval).to.equal(true);
    expect(byId.mass_payout.always_require_approval).to.equal(true);
  });
}

docs {
  GET /api/v1/admin/automation/actions — list action registry. EPIC-019/STORY-001.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/automation/actions
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "actions": [
              {
                "action_id": "suspend_entity",
                "category": "ADMIN",
                "name": "Suspend Entity",
                "description": "Suspends a pharmacy or rider account.",
                "required_params": ["entity_type", "entity_id", "reason"],
                "optional_params": [],
                "is_reversible": true,
                "always_require_approval": true
              },
              {
                "action_id": "mass_payout",
                "category": "FINANCE",
                "name": "Mass Payout",
                "description": "Triggers a mass payout batch (always requires approval).",
                "required_params": ["cycle_id"],
                "optional_params": ["entity_type"],
                "is_reversible": false,
                "always_require_approval": true
              }
            ],
            "total_actions": 16
          },
          "meta": {}
        }
      '''
    }
  }
}
