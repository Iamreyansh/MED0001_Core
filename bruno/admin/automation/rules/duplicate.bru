meta {
  name: duplicate
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/admin/automation/rules/{{automationRuleId}}/duplicate
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("automationRuleId")) {
    throw new Error("automationRuleId missing — run rules/create first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.new_rule_id) {
    bru.setEnvVar("automationRuleId", body.data.new_rule_id);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("duplicate envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.status).to.equal("INACTIVE");
    expect(body.data.name).to.match(/\(Copy\)$/);
    expect(body.data).to.have.property("new_rule_id");
  });
}

docs {
  POST /api/v1/admin/automation/rules/:id/duplicate — clone as INACTIVE with "(Copy)" suffix.
}

example {
  name: 201 Created
  request: {
    url: {{baseUrl}}/api/v1/admin/automation/rules/11111111-1111-4111-8111-111111111111/duplicate
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 201 text: Created }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "new_rule_id": "66666666-6666-4666-8666-666666666666",
            "name": "Auto-assign unassigned orders (Copy)",
            "status": "INACTIVE",
            "created_at": "2026-07-24T09:12:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}
