meta {
  name: get
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/admin/automation/rules/{{automationRuleId}}
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("automationRuleId")) {
    throw new Error("automationRuleId missing — run rules/create or rules/list first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.rule_id) {
    bru.setEnvVar("automationRuleId", body.data.rule_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("rule detail envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("conditions");
    expect(body.data).to.have.property("actions");
    expect(body.data).to.have.property("guardrails");
    expect(body.data).to.have.property("recent_fires");
  });
}

docs {
  GET /api/v1/admin/automation/rules/:id — rule detail with recent_fires.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/automation/rules/11111111-1111-4111-8111-111111111111
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "rule_id": "11111111-1111-4111-8111-111111111111",
            "name": "Auto-assign unassigned orders",
            "description": "Automatically assigns orders unassigned for > 5 minutes",
            "trigger_id": "order_unassigned",
            "trigger_params": { "duration_minutes": 5 },
            "conditions": [
              { "field": "zone.coverage_status", "operator": "not_eq", "value": "NO_RIDERS" }
            ],
            "actions": [
              { "action_id": "auto_assign_rider", "params": { "priority_override": null }, "parallel": false }
            ],
            "guardrails": {
              "rate_limit": { "max_fires": 60, "per_minutes": 60 },
              "value_cap": null,
              "require_approval_above": null
            },
            "status": "ACTIVE",
            "fire_count": 1248,
            "last_fired_at": "2026-07-24T08:07:00Z",
            "is_seed_rule": true,
            "created_by": "SYSTEM",
            "created_at": "2026-01-01T00:00:00Z",
            "recent_fires": []
          },
          "meta": {}
        }
      '''
    }
  }
}
