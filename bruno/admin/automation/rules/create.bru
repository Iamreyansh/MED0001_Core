meta {
  name: create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/admin/automation/rules
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Escalate unassigned orders {{$timestamp}}",
    "description": "Auto-assign when unassigned too long",
    "trigger_id": "order_unassigned",
    "trigger_params": {
      "duration_minutes": 5
    },
    "conditions": [
      {
        "field": "zone_id",
        "operator": "zone_in",
        "value": ["zone-blore-central"]
      }
    ],
    "actions": [
      {
        "action_id": "auto_assign_rider",
        "params": {
          "order_id": "{{automationEntityId}}"
        },
        "parallel": false
      }
    ],
    "guardrails": {
      "rate_limit": {
        "max_fires": 60,
        "per_minutes": 60
      },
      "require_approval_above": null
    }
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("automationEntityId")) {
    bru.setEnvVar("automationEntityId", crypto.randomUUID());
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.rule_id) {
    bru.setEnvVar("automationRuleId", body.data.rule_id);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("created inactive", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.status).to.equal("INACTIVE");
    expect(body.data).to.have.property("rule_id");
  });
}

docs {
  POST /api/v1/admin/automation/rules — create rule (always INACTIVE).
}

example {
  name: 201 Created
  request: {
    url: {{baseUrl}}/api/v1/admin/automation/rules
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "name": "Escalate SLA-breaching tickets",
        "trigger_id": "order_unassigned",
        "conditions": [],
        "actions": [
          { "action_id": "auto_assign_rider", "params": { "order_id": "22222222-2222-4222-8222-222222222222" } }
        ]
      }
    }
  }
  response: {
    status: { code: 201 text: Created }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "rule_id": "33333333-3333-4333-8333-333333333333",
            "name": "Escalate SLA-breaching tickets",
            "status": "INACTIVE",
            "created_by": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
            "created_at": "2026-07-24T01:55:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 409 RULE_NAME_CONFLICT
  request: {
    url: {{baseUrl}}/api/v1/admin/automation/rules
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
    body:json: {
      {
        "name": "Escalate SLA-breaching tickets",
        "trigger_id": "order_unassigned",
        "actions": [
          { "action_id": "auto_assign_rider", "params": {} }
        ]
      }
    }
  }
  response: {
    status: { code: 409 text: Conflict }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "RULE_NAME_CONFLICT",
            "message": "Rule name already exists"
          }
        }
      '''
    }
  }
}
