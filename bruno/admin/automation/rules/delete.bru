meta {
  name: delete
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/api/v1/admin/automation/rules/{{automationRuleId}}?force=false
  body: none
  auth: inherit
}

params:query {
  force: false
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("automationRuleId")) {
    throw new Error("automationRuleId missing — run rules/create first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200 or expected error", function () {
    const status = res.getStatus();
    expect([200, 422, 403]).to.include(status);
  });
  test("envelope", function () {
    const body = res.getBody();
    if (res.getStatus() === 200) {
      expect(body.success).to.equal(true);
      expect(body.data.deleted).to.equal(true);
    } else {
      expect(body.success).to.equal(false);
      expect(body.error).to.have.property("code");
    }
  });
}

docs {
  DELETE /api/v1/admin/automation/rules/:id — INACTIVE + fire_count=0, or force soft-delete (admin_super). Seed rules 403.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/automation/rules/55555555-5555-4555-8555-555555555555
    method: delete
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "deleted": true,
            "rule_id": "55555555-5555-4555-8555-555555555555",
            "deleted_at": "2026-07-24T09:10:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 422 RULE_HAS_FIRE_HISTORY
  request: {
    url: {{baseUrl}}/api/v1/admin/automation/rules/11111111-1111-4111-8111-111111111111
    method: delete
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 422 text: Unprocessable Entity }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "RULE_HAS_FIRE_HISTORY",
            "message": "Rule has fire history; use force=true"
          }
        }
      '''
    }
  }
}
