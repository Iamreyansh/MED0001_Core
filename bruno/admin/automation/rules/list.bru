meta {
  name: list
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/automation/rules?status=ACTIVE&trigger_category=DISPATCH&page=1&limit=20
  body: none
  auth: inherit
}

params:query {
  status: ACTIVE
  trigger_category: DISPATCH
  page: 1
  limit: 20
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && Array.isArray(body.data.rules) && body.data.rules.length) {
    bru.setEnvVar("automationRuleId", body.data.rules[0].rule_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("rules list envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("rules");
    expect(body.meta).to.have.property("page");
  });
}

docs {
  GET /api/v1/admin/automation/rules — list rules with status/trigger_category/search filters.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/automation/rules?status=ACTIVE&trigger_category=DISPATCH
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "rules": [
              {
                "rule_id": "11111111-1111-4111-8111-111111111111",
                "name": "Auto-assign unassigned orders",
                "trigger_id": "order_unassigned",
                "trigger_category": "DISPATCH",
                "conditions_summary": "zone.coverage_status not_eq NO_RIDERS",
                "actions_summary": "auto_assign_rider",
                "status": "ACTIVE",
                "fire_count": 1248,
                "last_fired_at": "2026-07-24T08:07:00Z",
                "created_at": "2026-02-01T10:00:00Z",
                "is_seed_rule": true
              }
            ]
          },
          "meta": { "page": 1, "limit": 20, "total": 1, "has_next": false }
        }
      '''
    }
  }
}
