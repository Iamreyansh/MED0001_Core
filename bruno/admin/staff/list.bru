meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/staff?page=1&limit=20&role=&status=&search=
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("adminAccessToken")) {
    throw new Error("adminAccessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (!(body && body.success && Array.isArray(body.data) && body.data.length)) {
    return;
  }
  if (body.data[0].id) {
    bru.setEnvVar("adminStaffId", body.data[0].id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.be.an("array");
    expect(body.meta).to.be.an("object");
    expect(body.meta.has_next).to.be.a("boolean");
  });
}

docs {
  GET /api/v1/admin/staff — list admin staff (any admin). Soft-deleted excluded.
  Errors: 401 UNAUTHORIZED, 403 FORBIDDEN
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/staff?page=1&limit=20
    method: get
    headers: { Authorization: Bearer {{adminAccessToken}} }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": [
            {
              "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
              "name": "Ayesha Siddiqui",
              "email": "ayesha@nammamedmate.com",
              "role": "admin_super",
              "status": "ACTIVE",
              "mfa_enabled": true,
              "last_active_at": "2026-07-24T01:00:00Z",
              "created_at": "2025-06-01T09:00:00Z"
            }
          ],
          "meta": { "page": 1, "limit": 20, "total": 1, "has_next": false }
        }
      '''
    }
  }
}

example {
  name: 403 FORBIDDEN
  response: {
    status: { code: 403 }
    body: {
      type: json
      content: '''
        { "success": false, "error": { "code": "FORBIDDEN", "message": "Admin access required" } }
      '''
    }
  }
}
