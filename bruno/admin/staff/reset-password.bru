meta {
  name: reset-password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/admin/staff/{{adminStaffId}}/reset-password
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("adminAccessToken")) {
    throw new Error("adminAccessToken missing — admin_super required");
  }
  if (!bru.getEnvVar("adminStaffId")) {
    throw new Error("adminStaffId missing");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.reset_link_expires_at).to.be.a("string");
    expect(body.data.message).to.include("Password reset email sent");
  });
}

docs {
  POST /api/v1/admin/staff/:id/reset-password — send reset email (4h TTL). Rate limit 5/hour per target.
  Errors: 401 UNAUTHORIZED, 403 FORBIDDEN, 404 STAFF_NOT_FOUND, 429 RATE_LIMITED
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/staff/a1b2c3d4-e5f6-7890-abcd-ef1234567890/reset-password
    method: post
    headers: { Authorization: Bearer {{adminAccessToken}} }
  }
  response: {
    status: { code: 200 }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "message": "Password reset email sent to sundar@nammamedmate.com.",
            "reset_link_expires_at": "2026-07-24T06:00:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 429 RATE_LIMITED
  response: {
    status: { code: 429 }
    body: {
      type: json
      content: '''
        { "success": false, "error": { "code": "RATE_LIMITED", "message": "Too many reset emails sent for this staff member" } }
      '''
    }
  }
}
