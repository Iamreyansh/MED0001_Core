meta {
  name: customers
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/admin/segments/{{segmentId}}/customers?page=1&limit=20&sort=ltv_rs&order=desc
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 20
  sort: ltv_rs
  order: desc
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("segmentId")) {
    throw new Error("segmentId missing — run admin/segments/create or list first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && Array.isArray(body.data.customers) && body.data.customers.length) {
    bru.setEnvVar("segmentCustomerId", body.data.customers[0].id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("customers envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("customers");
    expect(body.meta).to.have.property("total");
  });
}

docs {
  GET /api/v1/admin/segments/:id/customers — paginated members (admin_super|ops only).
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/segments/{{segmentId}}/customers?page=1&limit=20&sort=ltv_rs&order=desc
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "customers": [
              {
                "id": "cust_uuid_001",
                "name": "Priya Sharma",
                "phone": "+919876543210",
                "total_orders": 45,
                "ltv_rs": 14500.00,
                "last_order_at": "2026-07-20T15:30:00Z"
              }
            ]
          },
          "meta": { "page": 1, "limit": 20, "total": 1840, "has_next": true }
        }
      '''
    }
  }
}
