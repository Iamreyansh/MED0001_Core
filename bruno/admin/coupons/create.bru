meta {
  name: create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/coupons
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "code": "FLAT99",
    "type": "FLAT_RS",
    "value": 99,
    "min_order_value": 399,
    "max_discount_cap": 99,
    "max_redemptions_total": 1000,
    "max_per_user": 1,
    "budget_total": 50000,
    "segment_ids": [],
    "is_first_order_only": false,
    "is_rx_orders_only": false,
    "valid_from": "2026-08-01T00:00:00Z",
    "valid_until": "2026-12-31T23:59:59Z",
    "description": "Rs 99 flat off",
    "terms": "Once per user"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.code) {
    bru.setEnvVar("couponCode", body.data.code);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("create envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.code).to.equal("FLAT99");
    expect(body.data.status).to.equal("ACTIVE");
  });
}

docs {
  POST /api/v1/admin/coupons — create coupon.
}

example {
  name: 201 Created
  request: {
    url: {{baseUrl}}/api/v1/admin/coupons
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "code": "FLAT99",
        "type": "FLAT_RS",
        "value": 99,
        "min_order_value": 399,
        "budget_total": 50000,
        "valid_from": "2026-08-01T00:00:00Z",
        "valid_until": "2026-12-31T23:59:59Z"
      }
    }
  }
  response: {
    status: { code: 201 text: Created }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "a0130001-0000-4000-8000-000000000099",
            "code": "FLAT99",
            "type": "FLAT_RS",
            "status": "ACTIVE",
            "created_at": "2026-07-24T07:30:00Z",
            "created_by": "admin_uuid_001"
          }
        }
      '''
    }
  }
}

example {
  name: 409 COUPON_CODE_EXISTS
  request: {
    url: {{baseUrl}}/api/v1/admin/coupons
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "code": "NAMMA25",
        "type": "PERCENTAGE",
        "value": 25,
        "budget_total": 1000,
        "valid_from": "2026-08-01T00:00:00Z",
        "valid_until": "2026-12-31T23:59:59Z"
      }
    }
  }
  response: {
    status: { code: 409 text: Conflict }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "COUPON_CODE_EXISTS",
            "message": "Coupon code already exists"
          }
        }
      '''
    }
  }
}
