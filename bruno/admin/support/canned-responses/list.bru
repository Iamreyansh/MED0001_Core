meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/support/canned-responses?q=/refund&category=ORDER&page=1&limit=20
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.canned_responses && body.data.canned_responses[0]) {
    bru.setEnvVar("cannedResponseId", body.data.canned_responses[0].id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("canned envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.canned_responses).to.be.an("array");
  });
}

docs {
  GET /api/v1/admin/support/canned-responses — list/search canned responses (admin_super|operations|support).
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/support/canned-responses?q=/refund
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "canned_responses": [
              {
                "id": "a1500005-0001-4000-8000-000000000010",
                "title": "Payment refund - processing time",
                "category": "PAYMENT",
                "body": "Hi {customer_name}, refund processed.",
                "shortcut_key": "/refund-processing",
                "copy_count": 148,
                "last_used_at": "2026-07-24T10:20:00Z"
              }
            ]
          },
          "meta": { "page": 1, "limit": 20, "total": 1, "has_next": false }
        }
      '''
    }
  }
}
