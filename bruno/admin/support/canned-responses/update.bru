meta {
  name: update
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/admin/support/canned-responses/{{cannedResponseId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "body": "Hi {customer_name}, your refund of {refund_amount} has been initiated.",
    "shortcut_key": "/refund-status"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("cannedResponseId")) {
    throw new Error("cannedResponseId missing — run create first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("update envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.id).to.be.ok;
  });
}

docs {
  PATCH /api/v1/admin/support/canned-responses/:id
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/support/canned-responses/a1500005-0001-4000-8000-000000000010
    method: patch
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "body": "Hi {customer_name}, refund initiated.",
        "shortcut_key": "/refund-status"
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "a1500005-0001-4000-8000-000000000010",
            "updated_at": "2026-07-24T11:00:00Z"
          }
        }
      '''
    }
  }
}
