meta {
  name: export-csv
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/support/tickets?export=true
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200 CSV", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.include("text/csv");
  });
}

docs {
  GET /api/v1/admin/support/tickets?export=true — CSV download.
}

example {
  name: 200 CSV
  request: {
    url: {{baseUrl}}/api/v1/admin/support/tickets?export=true
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: text
      content: '''
        ticket_id,customer_id,category,subject,status,priority,sla_level,sla_due_at,sla_breached,channel,assigned_agent_id,created_at
      '''
    }
  }
}
