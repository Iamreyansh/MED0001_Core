meta {
  name: notify
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/admin/customers/{{customerId}}/notify
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

body:json {
  {
    "channel": "PUSH",
    "title": "Order update",
    "body": "Your prescription order is ready for pickup.",
    "deep_link": "medmate://orders/123"
  }
}

script:pre-request {
  if (!bru.getEnvVar("adminAccessToken")) {
    throw new Error("adminAccessToken missing — admin login first");
  }
  if (!bru.getEnvVar("customerId")) {
    throw new Error("customerId missing — run customers/me/get or admin/customers/list first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.notification_id) {
    bru.setEnvVar("lastNotificationId", body.data.notification_id);
  }
}

tests {
  test("HTTP 200 or rate limited", function () {
    const status = res.getStatus();
    if (status === 200) {
      expect(status).to.equal(200);
      return;
    }
    expect(status).to.equal(429);
    expect(res.getBody().error.code).to.equal("NOTIFICATION_RATE_LIMITED");
  });

  test("success envelope when notification sent", function () {
    if (res.getStatus() !== 200) {
      return;
    }
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.notification_id).to.be.a("string").that.is.not.empty;
    expect(body.data.channel).to.equal("PUSH");
    expect(body.data.delivered).to.be.a("boolean");
    expect(body.data.queued_at).to.be.a("string").that.is.not.empty;
  });
}

docs {
  POST /api/v1/admin/customers/:id/notify — send PUSH/SMS/BOTH notification (max 3 per customer per 24h). Writes `lastNotificationId`.
  Errors: 400 VALIDATION_ERROR, 401 UNAUTHORIZED, 403 FORBIDDEN, 404 CUSTOMER_NOT_FOUND, 429 NOTIFICATION_RATE_LIMITED
}
