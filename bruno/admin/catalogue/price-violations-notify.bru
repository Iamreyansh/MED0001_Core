meta {
  name: price-violations-notify
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/api/v1/admin/catalogue/price-violations/notify
  body: json
  auth: inherit
}

body:json {
  {
    "medicine_id": "{{medicineId}}",
    "message": "Please update your online price to at or below the platform ceiling."
  }
}

script:pre-request {
  if (!bru.getEnvVar("adminAccessToken")) {
    throw new Error("adminAccessToken missing — login as admin_super or admin_compliance first");
  }
}

script:post-response {
  // no chaining vars
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("notify envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.channels).to.deep.equal(["WHATSAPP", "IN_APP"]);
    expect(body.data).to.have.property("next_batch_allowed_at");
  });
}

docs {
  POST /api/v1/admin/catalogue/price-violations/notify — admin_super, admin_compliance.
  Publishes catalogue.notification.price_ceiling_violation outbox events. Max 1 batch/medicine/4h.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/catalogue/price-violations/notify
    method: post
    headers: {
      Authorization: Bearer {{adminAccessToken}}
    }
    body:json: {
      {
        "medicine_id": "{{medicineId}}",
        "message": "Please update your online price to at or below the platform ceiling."
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "pharmacies_notified": 3,
            "violations_covered": 3,
            "channels": ["WHATSAPP", "IN_APP"],
            "notified_at": "2026-07-24T00:00:00Z",
            "next_batch_allowed_at": "2026-07-24T04:00:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 429 NOTIFICATION_RATE_LIMITED
  response: {
    status: { code: 429 }
    body: {
      type: json
      content: '''
        { "success": false, "error": { "code": "NOTIFICATION_RATE_LIMITED", "message": "Batch notification for this medicine sent within last 4 hours" } }
      '''
    }
  }
}
