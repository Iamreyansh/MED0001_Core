meta {
  name: get
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/admin/catalogue/{{medicineId}}
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("adminAccessToken")) {
    throw new Error("adminAccessToken missing — login as admin first");
  }
  if (!bru.getEnvVar("medicineId")) {
    throw new Error("medicineId missing — run create or list first");
  }
}

script:post-response {
  // no chaining vars
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("detail envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.include.keys(
      "medicine_id",
      "stocking_pharmacies",
      "substitutes",
      "demand_stats",
      "mrp_ceiling"
    );
  });
}

docs {
  GET /api/v1/admin/catalogue/:id — stocking_pharmacies empty until STORY-005.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/catalogue/{{medicineId}}
    method: get
    headers: {
      Authorization: Bearer {{adminAccessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "medicine_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "name": "Augmentin 625 Tablet",
            "salt_composition": "Amoxicillin (500mg) + Clavulanic Acid (125mg)",
            "manufacturer": "GSK India",
            "category": { "category_id": "c0000001-0000-4000-8000-000000000001", "name": "Antibiotics" },
            "form": "TABLET",
            "pack_size": 10.00,
            "pack_unit": "TABLET",
            "schedule": "H",
            "hsn_code": "30041090",
            "gst_pct": 12,
            "mrp": 218.50,
            "mrp_ceiling": null,
            "is_rx_only": true,
            "is_banned": false,
            "ban_reason": null,
            "description": "Combination antibiotic for bacterial infections.",
            "monthly_demand": 0,
            "mapped_pharmacy_count": 0,
            "substitutes": [],
            "stocking_pharmacies": [],
            "demand_stats": {
              "monthly_demand": 0,
              "monthly_demand_trend": "STABLE",
              "top_zone": null
            },
            "created_by": "11111111-1111-4111-8111-111111111111",
            "created_at": "2026-08-08T00:00:00Z",
            "updated_at": "2026-08-08T00:00:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 404 MEDICINE_NOT_FOUND
  response: {
    status: { code: 404 }
    body: {
      type: json
      content: '''
        { "success": false, "error": { "code": "MEDICINE_NOT_FOUND", "message": "Medicine not found" } }
      '''
    }
  }
}
