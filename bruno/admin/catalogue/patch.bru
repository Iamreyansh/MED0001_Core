meta {
  name: patch
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/api/v1/admin/catalogue/{{medicineId}}
  body: json
  auth: inherit
}

body:json {
  {
    "description": "Updated description for Augmentin 625.",
    "gst_pct": 12
  }
}

script:pre-request {
  if (!bru.getEnvVar("adminAccessToken")) {
    throw new Error("adminAccessToken missing — login as admin first");
  }
  if (!bru.getEnvVar("medicineId")) {
    throw new Error("medicineId missing — run create or list first");
  }
}

script:post-response {
  // no chaining vars
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("patch envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.medicine_id).to.be.a("string");
    expect(body.data.updated_fields).to.be.an("array");
  });
}

docs {
  PATCH /api/v1/admin/catalogue/:id — monthly_demand ignored; banned medicines return MEDICINE_IS_BANNED.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/catalogue/{{medicineId}}
    method: patch
    headers: {
      Authorization: Bearer {{adminAccessToken}}
    }
    body:json: {
      {
        "description": "Updated description for Augmentin 625.",
        "gst_pct": 12
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "medicine_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "updated_fields": ["description"],
            "updated_at": "2026-08-08T00:00:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 400 INVALID_GST_RATE
  response: {
    status: { code: 400 }
    body: {
      type: json
      content: '''
        { "success": false, "error": { "code": "INVALID_GST_RATE", "message": "gst_pct must be 5, 12, or 18" } }
      '''
    }
  }
}
