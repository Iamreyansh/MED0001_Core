meta {
  name: unban
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/v1/admin/catalogue/{{medicineId}}/unban
  body: json
  auth: inherit
}

body:json {
  {
    "reason": "CDSCO ban lifted after review"
  }
}

script:pre-request {
  if (!bru.getEnvVar("adminAccessToken")) {
    throw new Error("adminAccessToken missing — login as admin_super or admin_compliance first");
  }
  if (!bru.getEnvVar("medicineId")) {
    throw new Error("medicineId missing — run create or list first");
  }
}

script:post-response {
  // no chaining vars
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("unban envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.is_banned).to.equal(false);
    expect(body.data.note).to.be.a("string");
  });
}

docs {
  POST /api/v1/admin/catalogue/:id/unban — mappings stay hidden.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/catalogue/{{medicineId}}/unban
    method: post
    headers: {
      Authorization: Bearer {{adminAccessToken}}
    }
    body:json: {
      {
        "reason": "CDSCO ban lifted after review"
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "medicine_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "is_banned": false,
            "unbanned_at": "2026-08-08T00:00:00Z",
            "note": "Pharmacy mappings remain hidden. Pharmacies must manually re-enable items on their storefront."
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 400 REASON_REQUIRED
  response: {
    status: { code: 400 }
    body: {
      type: json
      content: '''
        { "success": false, "error": { "code": "REASON_REQUIRED", "message": "reason is required" } }
      '''
    }
  }
}
