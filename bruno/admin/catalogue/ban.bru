meta {
  name: ban
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/admin/catalogue/{{medicineId}}/ban
  body: json
  auth: inherit
}

body:json {
  {
    "reason": "Banned by CDSCO notification dated 2026-07-01"
  }
}

script:pre-request {
  if (!bru.getEnvVar("adminAccessToken")) {
    throw new Error("adminAccessToken missing — login as admin_super or admin_compliance first");
  }
  if (!bru.getEnvVar("medicineId")) {
    throw new Error("medicineId missing — run create or list first");
  }
}

script:post-response {
  // no chaining vars
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("ban envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.is_banned).to.equal(true);
    expect(body.data.storefront_removal_job_id).to.be.a("string");
  });
}

docs {
  POST /api/v1/admin/catalogue/:id/ban — admin_super, admin_compliance only.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/catalogue/{{medicineId}}/ban
    method: post
    headers: {
      Authorization: Bearer {{adminAccessToken}}
    }
    body:json: {
      {
        "reason": "Banned by CDSCO notification dated 2026-07-01"
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "medicine_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "is_banned": true,
            "ban_reason": "Banned by CDSCO notification dated 2026-07-01",
            "banned_at": "2026-08-08T00:00:00Z",
            "pharmacy_mappings_hidden": 0,
            "storefront_removal_job_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 409 ALREADY_BANNED
  response: {
    status: { code: 409 }
    body: {
      type: json
      content: '''
        { "success": false, "error": { "code": "ALREADY_BANNED", "message": "Medicine is already banned" } }
      '''
    }
  }
}
