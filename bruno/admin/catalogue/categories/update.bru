meta {
  name: update
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/v1/admin/catalogue/categories/{{categoryId}}
  body: json
  auth: inherit
}

body:json {
  {
    "is_visible": false
  }
}

script:pre-request {
  if (!bru.getEnvVar("categoryId")) {
    throw new Error("categoryId missing");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.updated_at) {
    bru.setEnvVar("categoryUpdatedAt", body.data.updated_at);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("update envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.updated_fields).to.be.an("array");
  });
}

docs {
  PATCH /api/v1/admin/catalogue/categories/:id — admin_super, admin_operations. Slug is immutable.
}

example {
  name: 200 OK
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "category_id": "c0000001-0000-4000-8000-000000000001",
            "updated_fields": ["is_visible"],
            "updated_at": "2026-08-08T00:00:00Z"
          }
        }
      '''
    }
  }
}

example {
  name: 404 CATEGORY_NOT_FOUND
  response: {
    status: { code: 404 }
    body: {
      type: json
      content: '''
        { "success": false, "error": { "code": "CATEGORY_NOT_FOUND", "message": "Category not found" } }
      '''
    }
  }
}
