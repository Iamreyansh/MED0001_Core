meta {
  name: reject
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/riders/{{riderId}}/reject
  body: json
  auth: inherit
}

body:json {
  { "reason": "DOCUMENT_UNCLEAR", "notes": "Blurry licence" }
}

script:pre-request {
  if (!bru.getEnvVar("adminAccessToken")) {
    throw new Error("adminAccessToken missing — run auth/admin/login first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("REJECTED", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.kyc_status).to.equal("REJECTED");
  });
}

docs {
  POST /api/v1/admin/riders/{id}/reject
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/riders/{{riderId}}/reject
    method: post
    headers: { Authorization: Bearer {{adminAccessToken}} }
    body:json: {
      { "reason": "DOCUMENT_UNCLEAR", "notes": "Blurry licence" }
    }
  }
  response: {
    status: { code: 200 }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "rider_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "kyc_status": "REJECTED"
          }
        }
      '''
    }
  }
}

example {
  name: 404 RIDER_NOT_FOUND
  response: {
    status: { code: 404 }
    body: {
      type: json
      content: '''
        { "success": false, "error": { "code": "RIDER_NOT_FOUND", "message": "rider_id does not exist" } }
      '''
    }
  }
}
