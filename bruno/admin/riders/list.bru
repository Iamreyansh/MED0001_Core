meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/riders?status=PENDING_KYC&page=1&limit=20
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("adminAccessToken")) {
    throw new Error("adminAccessToken missing — run auth/admin/login first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.riders).to.be.an("array");
  });
}

docs {
  GET /api/v1/admin/riders
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/riders?status=PENDING_KYC&page=1&limit=20
    method: get
    headers: { Authorization: Bearer {{adminAccessToken}} }
  }
  response: {
    status: { code: 200 }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": { "riders": [] },
          "meta": { "page": 1, "limit": 20, "total": 0, "has_next": false }
        }
      '''
    }
  }
}

example {
  name: 422 INVALID_STATUS_FILTER
  response: {
    status: { code: 422 }
    body: {
      type: json
      content: '''
        { "success": false, "error": { "code": "INVALID_STATUS_FILTER", "message": "status value not in allowed enum" } }
      '''
    }
  }
}
