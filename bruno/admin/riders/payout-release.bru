meta {
  name: payout-release
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/v1/admin/riders/{{riderId}}/payout/release
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{riderPayoutReleaseIdempotencyKey}}
}

body:json {
  {
    "payout_id": "{{payoutId}}",
    "notes": "Manual release approved after COD resolved."
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken") && !bru.getEnvVar("adminAccessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("accessToken") && bru.getEnvVar("adminAccessToken")) {
    bru.setEnvVar("accessToken", bru.getEnvVar("adminAccessToken"));
  }
  if (!bru.getEnvVar("riderId")) {
    throw new Error("riderId missing — run admin/riders/list first");
  }
  if (!bru.getEnvVar("payoutId")) {
    throw new Error("payoutId missing — run admin/riders/earnings-ledger first");
  }
  if (!bru.getEnvVar("riderPayoutReleaseIdempotencyKey")) {
    bru.setEnvVar("riderPayoutReleaseIdempotencyKey", "rider-payout-release-" + Date.now());
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data) {
    bru.setEnvVar("lastPayoutStatus", String(body.data.payout_status));
    if (body.data.razorpay_payout_id) {
      bru.setEnvVar("razorpayPayoutId", body.data.razorpay_payout_id);
    }
  }
}

tests {
  test("HTTP 200 or story error", function () {
    const status = res.getStatus();
    expect([200, 404, 409, 422]).to.include(status);
  });
  test("envelope", function () {
    const body = res.getBody();
    if (res.getStatus() === 200) {
      expect(body.success).to.equal(true);
      expect(body.data).to.have.property("payout_status");
    } else {
      expect(body.success).to.equal(false);
      expect(body.error).to.have.property("code");
    }
  });
}

docs {
  POST /api/v1/admin/riders/:id/payout/release — RazorpayX stub disbursement.
  Requires Idempotency-Key header.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/riders/{{riderId}}/payout/release
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
      Idempotency-Key: rider-payout-release-example-1
    }
    body:json: {
      {
        "payout_id": "c0000001-0000-4000-8000-0000000000p1",
        "notes": "Manual release approved after COD resolved."
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "payout_id": "c0000001-0000-4000-8000-0000000000p1",
            "rider_id": "a0000001-0000-4000-8000-0000000000r1",
            "net_payout": 1500.00,
            "payout_status": "RELEASED",
            "razorpay_payout_id": "pout_uuid",
            "released_by": "d0000001-0000-4000-8000-0000000000a1",
            "released_at": "2026-07-24T16:00:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 422 COD_UNRESOLVED
  response: {
    status: { code: 422 text: Unprocessable Entity }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "COD_UNRESOLVED",
            "message": "Rider has unresolved COD float > limit"
          }
        }
      '''
    }
  }
}
