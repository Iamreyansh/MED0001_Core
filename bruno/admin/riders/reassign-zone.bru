meta {
  name: reassign-zone
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v1/admin/riders/{{riderId}}/zone
  body: json
  auth: inherit
}

body:json {
  {
    "zone_id": "{{zoneId}}",
    "notify_rider": true
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing");
  }
  if (!bru.getEnvVar("riderId")) {
    throw new Error("riderId missing");
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("zone reassigned", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.new_zone_id).to.be.a("string");
  });
}

docs {
  PATCH /api/v1/admin/riders/:id/zone — reassign primary/current zone.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/riders/a1b2c3d4-e5f6-7890-abcd-ef1234567890/zone
    method: patch
    body:json: {
      {
        "zone_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
        "notify_rider": true
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "rider_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "new_zone_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
            "new_zone_name": "Indiranagar",
            "reassigned_by": "d4e5f6a7-b8c9-0123-def0-234567890123",
            "reassigned_at": "2026-07-24T10:35:00Z",
            "rider_notified": true
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 422 INVALID_ZONE
  response: {
    status: { code: 422 }
    body: {
      type: json
      content: '''
        { "success": false, "error": { "code": "INVALID_ZONE", "message": "zone_id does not exist" } }
      '''
    }
  }
}
