meta {
  name: get
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/monitoring/slo
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.slos && body.data.slos.length) {
    bru.setEnvVar("monitoringSloName", body.data.slos[0].slo_name);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("slo envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.slos).to.be.an("array");
    expect(body.data.slos[0]).to.have.property("error_budget_remaining_pct");
  });
}

docs {
  GET /api/v1/admin/monitoring/slo — EPIC-020/STORY-001.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/monitoring/slo
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "slos": [
              {
                "slo_name": "order_sla_adherence",
                "description": "95% of orders delivered within 45 minutes",
                "target_pct": 95.0,
                "current_pct_30d": 93.2,
                "error_budget_remaining_pct": 64.0,
                "last_30d_pct": 93.2,
                "trend": "DEGRADING",
                "compliant": false
              }
            ]
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 403 FORBIDDEN
  request: {
    url: {{baseUrl}}/api/v1/admin/monitoring/slo
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 403 text: Forbidden }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": { "code": "FORBIDDEN", "message": "Insufficient role" }
        }
      '''
    }
  }
}
