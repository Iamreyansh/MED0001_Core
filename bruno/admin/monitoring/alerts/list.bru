meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/monitoring/alerts?status=ACTIVE&page=1
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.alerts && body.data.alerts.length) {
    bru.setEnvVar("monitoringAlertId", body.data.alerts[0].id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("alerts envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("alerts");
    expect(body.meta).to.have.property("page");
  });
}

docs {
  GET /api/v1/admin/monitoring/alerts — EPIC-020/STORY-001.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/monitoring/alerts?status=ACTIVE&page=1
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "alerts": [
              {
                "id": "11111111-1111-4111-8111-111111111111",
                "severity": "CRITICAL",
                "type": "GMV_DROP",
                "message": "GMV drop detected",
                "triggered_at": "2026-07-24T09:00:00Z",
                "acknowledged": false,
                "acknowledged_by": null,
                "acknowledged_at": null,
                "auto_remediated": false,
                "resolved_at": null
              }
            ]
          },
          "meta": { "page": 1, "limit": 20, "total": 1, "has_next": false }
        }
      '''
    }
  }
}
