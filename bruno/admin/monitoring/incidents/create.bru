meta {
  name: create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/monitoring/incidents
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Payment gateway degraded",
    "severity": "P1",
    "description": "Capture rate dropped below SLO",
    "affected_services": ["PAYMENT_GATEWAY", "ORDER_MANAGEMENT"],
    "impacted_metrics": {
      "payment_success_pct": 92.1
    }
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.id) {
    bru.setEnvVar("monitoringIncidentId", body.data.id);
    bru.setEnvVar("monitoringIncidentNumber", body.data.incident_number);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("incident create envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.have.property("id");
    expect(body.data).to.have.property("incident_number");
    expect(body.data.status).to.equal("DETECTED");
  });
}

docs {
  POST /api/v1/admin/monitoring/incidents — EPIC-020/STORY-003 declare incident.
}

example {
  name: 201 Created
  request: {
    url: {{baseUrl}}/api/v1/admin/monitoring/incidents
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "title": "Payment gateway degraded",
        "severity": "P1",
        "description": "Capture rate dropped below SLO",
        "affected_services": ["PAYMENT_GATEWAY", "ORDER_MANAGEMENT"],
        "impacted_metrics": {
          "payment_success_pct": 92.1
        }
      }
    }
  }
  response: {
    status: { code: 201 text: Created }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
            "incident_number": "INC-20260724-001",
            "title": "Payment gateway degraded",
            "severity": "P1",
            "status": "DETECTED",
            "detected_at": "2026-07-24T10:00:00Z",
            "created_by": "11111111-1111-4111-8111-111111111111"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 400 INVALID_SEVERITY
  request: {
    url: {{baseUrl}}/api/v1/admin/monitoring/incidents
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "title": "x",
        "severity": "P9",
        "description": "bad",
        "affected_services": ["PAYMENT_GATEWAY"]
      }
    }
  }
  response: {
    status: { code: 400 text: Bad Request }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "INVALID_SEVERITY",
            "message": "severity not in P1/P2/P3"
          }
        }
      '''
    }
  }
}
