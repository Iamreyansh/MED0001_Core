meta {
  name: rebalancing-apply
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/admin/zones/rebalancing/{{suggestionId}}/apply
  body: json
  auth: inherit
}

body:json {
  {}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
  if (!bru.getEnvVar("suggestionId")) {
    throw new Error("suggestionId missing — run rebalancing-suggestions first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("apply envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.applied).to.equal(true);
  });
}

docs {
  POST /api/v1/admin/zones/rebalancing/:id/apply — notify riders via outbox push.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/zones/rebalancing/33333333-3333-4333-8333-333333333333/apply
    method: post
    body:json: {
      {}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "suggestion_id": "33333333-3333-4333-8333-333333333333",
            "applied": true,
            "riders_notified": 2,
            "applied_by": "22222222-2222-4222-8222-222222222222",
            "applied_at": "2026-07-24T11:17:00Z"
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 409 SUGGESTION_ALREADY_APPLIED
  request: {
    url: {{baseUrl}}/api/v1/admin/zones/rebalancing/33333333-3333-4333-8333-333333333333/apply
    method: post
    body:json: {
      {}
    }
  }
  response: {
    status: { code: 409 text: Conflict }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": { "code": "SUGGESTION_ALREADY_APPLIED", "message": "Suggestion was already applied" }
        }
      '''
    }
  }
}
