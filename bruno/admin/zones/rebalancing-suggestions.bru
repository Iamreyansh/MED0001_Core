meta {
  name: rebalancing-suggestions
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/admin/zones/rebalancing-suggestions
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/admin/login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && body.data && body.data.suggestions && body.data.suggestions[0]) {
    bru.setEnvVar("suggestionId", body.data.suggestions[0].suggestion_id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("suggestions envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.suggestions).to.be.an("array");
  });
}

docs {
  GET /api/v1/admin/zones/rebalancing-suggestions — stub AI suggestions (EPIC-015 later).
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/admin/zones/rebalancing-suggestions
    method: get
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "suggestions": [
