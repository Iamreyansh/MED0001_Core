meta {
  name: notes-list
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/api/v1/admin/pharmacies/{{pharmacyId}}/notes?is_flagged=false&page=1&limit=20
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("pharmacyId")) {
    throw new Error("pharmacyId missing");
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("notes list envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.notes).to.be.an("array");
    expect(body.meta.page).to.equal(1);
  });
}

docs {
  GET /api/v1/admin/pharmacies/{id}/notes — admin-only internal notes.
}

example {
  name: 200 OK
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "pharmacy_id": "11111111-1111-4111-8111-111111111111",
            "notes": [
              {
                "note_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
                "note": "Flagged compliance concern",
                "is_flagged": true,
                "created_at": "2026-07-24T00:10:00Z"
              }
            ]
          },
          "meta": { "page": 1, "limit": 20, "total": 1, "has_next": false }
        }
      '''
    }
  }
}
