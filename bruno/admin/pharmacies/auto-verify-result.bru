meta {
  name: get-auto-kyc-result
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/admin/pharmacies/{{pharmacyId}}/kyc/auto-verify-result?job_id={{autoKycJobId}}
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("pharmacyId")) {
    throw new Error("pharmacyId missing");
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("auto-verify result envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.pharmacy_id).to.be.a("string");
    expect(body.data.job_id).to.be.a("string");
    expect(body.data.overall_status).to.be.a("string");
    expect(body.data.checks).to.be.an("array");
    expect(body.data.admin_flags).to.be.an("array");
  });
}

docs {
  GET /api/v1/admin/pharmacies/{id}/kyc/auto-verify-result — poll auto-KYC job results.
  Requires permission: pharmacies:read. Optional job_id query param (defaults to latest).
}

example {
  name: 200 OK — partial results
  description: Latest auto-KYC job with mixed check statuses.

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "pharmacy_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
            "job_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "overall_status": "PARTIAL",
            "auto_activated": false,
            "triggered_at": "2026-07-24T00:00:00Z",
            "completed_at": null,
            "checks": [
              {
                "verification_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
                "verification_type": "GSTIN",
                "api_provider": "GSTN_SANDBOX_API",
                "status": "PASS",
                "details": {
                  "gstin": "27AABCS1429B1ZB",
                  "name_match": "WARN"
                },
                "checked_at": "2026-07-24T00:00:05Z",
                "retry_count": 0
              }
            ],
            "admin_flags": [
              {
                "flag": "BUSINESS_NAME_MISMATCH",
                "detail": "GSTIN-registered name differs from platform name.",
                "severity": "WARN"
              }
            ]
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 404 NO_AUTO_KYC_JOB
  description: No auto-KYC job has been run for this pharmacy.

  response: {
    status: {
      code: 404
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "NO_AUTO_KYC_JOB",
            "message": "No auto-KYC job has been run for this pharmacy"
          }
        }
      '''
    }
  }
}
