meta {
  name: trigger-auto-kyc
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/admin/pharmacies/{{pharmacyId}}/kyc/auto-verify
  body: json
  auth: inherit
}

headers {
  content-type: application/json
}

body:json {
  {
    "checks": ["GSTIN", "DRUG_LICENCE", "FSSAI"]
  }
}

script:pre-request {
  if (!bru.getEnvVar("pharmacyId")) {
    throw new Error("pharmacyId missing — run pharmacy/register and kyc/submit first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body.success && body.data && body.data.job_id) {
    bru.setEnvVar("autoKycJobId", body.data.job_id);
  }
}

tests {
  test("HTTP 202 Accepted", function () {
    expect(res.getStatus()).to.equal(202);
  });

  test("auto-verify trigger envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.pharmacy_id).to.equal(bru.getEnvVar("pharmacyId"));
    expect(body.data.job_id).to.be.a("string");
    expect(body.data.checks_triggered).to.be.an("array");
    expect(body.data.estimated_completion_minutes).to.be.a("number");
  });
}

docs {
  POST /api/v1/admin/pharmacies/{id}/kyc/auto-verify — manually trigger auto-KYC.
  Requires permission: pharmacies:update. Roles: admin_super, admin_operations.
  Returns 503 FEATURE_FLAG_DISABLED when medmate.kyc.auto-verification-enabled=false.
}

example {
  name: 202 Accepted — auto-KYC triggered
  description: GSTIN runs synchronously; drug licence and FSSAI dispatched async.

  request: {
    url: {{baseUrl}}/api/v1/admin/pharmacies/{{pharmacyId}}/kyc/auto-verify
    method: post
    mode: json
    headers: {
      Authorization: Bearer {{adminAccessToken}}
    }
    body:json: {
      {
        "checks": ["GSTIN", "DRUG_LICENCE", "FSSAI"]
      }
    }
  }

  response: {
    status: {
      code: 202
      text: Accepted
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "pharmacy_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
            "job_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "checks_triggered": ["GSTIN", "DRUG_LICENCE", "FSSAI"],
            "gstin_result": {
              "status": "PASS",
              "gstin": "27AABCS1429B1ZB"
            },
            "drug_licence_result": {
              "status": "PENDING",
              "message": "Async check dispatched. Poll auto-verify-result for status."
            },
            "fssai_result": {
              "status": "PENDING",
              "message": "Async check dispatched. Poll auto-verify-result for status."
            },
            "estimated_completion_minutes": 10
          },
          "meta": {}
        }
      '''
    }
  }
}

example {
  name: 503 FEATURE_FLAG_DISABLED
  description: Auto-KYC feature flag is off.

  response: {
    status: {
      code: 503
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "FEATURE_FLAG_DISABLED",
            "message": "Auto KYC verification is disabled on this platform"
          }
        }
      '''
    }
  }
}
