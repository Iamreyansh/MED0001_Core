meta {
  name: profile-patch
  type: http
  seq: 20
}

patch {
  url: {{baseUrl}}/api/v1/admin/pharmacies/{{pharmacyId}}/profile
  auth: inherit
  body: json
}

body:json {
  {
    "tagline": "Admin updated tagline"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — login as admin_super or admin_operations first");
  }
  if (!bru.getEnvVar("pharmacyId")) {
    throw new Error("pharmacyId missing");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("envelope", function () {
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().data.changed_fields).to.be.an("array");
  });
}

docs {
  PATCH /api/v1/admin/pharmacies/{id}/profile — admin_super / admin_operations.
  business_name requires admin_super. Changes are audit-logged.
}

example {
  name: 200 OK
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "pharmacy_id": "11111111-1111-4111-8111-111111111111",
            "changed_fields": ["tagline"],
            "message": "Profile updated successfully."
          },
          "meta": {}
        }
      '''
    }
  }
}
