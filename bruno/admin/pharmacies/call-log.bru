meta {
  name: call-log
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/api/v1/admin/pharmacies/{{pharmacyId}}/call-log
  body: json
  auth: inherit
}

body:json {
  {
    "duration_seconds": 342,
    "call_outcome": "FOLLOW_UP_REQUIRED",
    "notes": "Owner will upload documents by Friday."
  }
}

script:pre-request {
  if (!bru.getEnvVar("pharmacyId")) {
    throw new Error("pharmacyId missing");
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("call log created", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.call_log_id).to.be.a("string");
    expect(body.data.duration_formatted).to.equal("5m 42s");
  });
}

docs {
  POST /api/v1/admin/pharmacies/{id}/call-log — immutable call log (201). No edit/delete endpoints.
}

example {
  name: 201 Created
  response: {
    status: { code: 201 text: Created }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "call_log_id": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
            "pharmacy_id": "11111111-1111-4111-8111-111111111111",
            "duration_seconds": 342,
            "duration_formatted": "5m 42s",
            "call_outcome": "FOLLOW_UP_REQUIRED",
            "logged_at": "2026-07-24T00:10:00Z"
          }
        }
      '''
    }
  }
}
