meta {
  name: bank-account-get
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/v1/admin/pharmacies/{{pharmacyId}}/bank-account
  auth: inherit
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — login as admin_finance or admin_super first");
  }
  if (!bru.getEnvVar("pharmacyId")) {
    throw new Error("pharmacyId missing");
  }
}

script:post-response {
}

tests {
  test("HTTP 200 or 404", function () {
    expect(res.getStatus()).to.be.oneOf([200, 404]);
  });
  test("envelope", function () {
    const body = res.getBody();
    expect(body).to.have.property("success");
    if (body.success) {
      expect(body.data.account_number_masked).to.be.a("string");
    } else {
      expect(body.error.code).to.equal("BANK_ACCOUNT_NOT_FOUND");
    }
  });
}

docs {
  GET /api/v1/admin/pharmacies/{id}/bank-account — admin_finance / admin_super only.
}

example {
  name: 200 OK
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "bank_account_id": "22222222-2222-4222-8222-222222222222",
            "account_holder": "Sharma Medical Store",
            "bank_name": "HDFC Bank",
            "account_number_masked": "XXXXXXXXXXXX4321",
            "ifsc_code": "HDFC0001234",
            "account_type": "CURRENT",
            "verification_status": "VERIFIED",
            "verified_at": "2026-07-20T10:00:00Z",
            "penny_drop_reference": "RZP-PENNY-XXXXX"
          },
          "meta": {}
        }
      '''
    }
  }
}
