meta {
  name: list-permissions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/admin/permissions?resource=orders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("adminAccessToken")) {
    throw new Error("adminAccessToken missing — admin login first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("orders permissions only", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.be.an("array").that.is.not.empty;
    body.data.forEach((p) => expect(p.resource).to.equal("orders"));
  });
}

docs {
  GET /api/v1/admin/permissions?resource= — filter optional. Admin catalog only.
}

example {
  name: 200 OK
  description: Orders permissions from the admin catalog.

  request: {
    url: {{baseUrl}}/api/v1/admin/permissions?resource=orders
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{adminAccessToken}}
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": [
            {
              "resource": "orders",
              "action": "read",
              "permission": "orders:read",
              "description": "View order details and history"
            },
            {
              "resource": "orders",
              "action": "write",
              "permission": "orders:write",
              "description": "Create and modify orders"
            },
            {
              "resource": "orders",
              "action": "cancel",
              "permission": "orders:cancel",
              "description": "Cancel any order"
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 403 FORBIDDEN
  description: Non-admin token cannot access the admin permission catalog.

  request: {
    url: {{baseUrl}}/api/v1/admin/permissions?resource=orders
    method: get
    mode: none
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }

  response: {
    status: {
      code: 403
      text: Forbidden
    }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "FORBIDDEN",
            "message": "Admin role required"
          }
        }
      '''
    }
  }
}
