meta {
  name: list-roles
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/roles
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminAccessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("adminAccessToken")) {
    throw new Error("adminAccessToken missing — admin login first");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && Array.isArray(body.data) && body.data.length) {
    bru.setEnvVar("adminRoleSample", body.data[0].role);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("five admin roles with admin_super wildcard", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data).to.be.an("array").with.lengthOf(5);
    expect(body.data[0].role).to.equal("admin_super");
    expect(body.data[0].permissions).to.deep.equal(["*:*"]);
  });
}

docs {
  GET /api/v1/admin/roles — any admin role. Returns immutable built-in admin role matrix.
}
