meta {
  name: get
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/pharmacies/{{pharmacyId}}?lat=12.9345&lng=77.6125
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing — run auth/customer/verify-otp first");
  }
  if (!bru.getEnvVar("pharmacyId")) {
    throw new Error("pharmacyId missing — run pharmacies/nearby or cart/smart-select first");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("storefront envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.id).to.be.a("string");
    expect(body.data).to.have.property("is_open");
  });
}

docs {
  GET /api/v1/pharmacies/:id — customer pharmacy storefront.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/pharmacies/aaaaaaaa-0001-4000-8000-000000000001?lat=12.9345&lng=77.6125
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "id": "aaaaaaaa-0001-4000-8000-000000000001",
            "name": "Sai Medicals",
            "area": "Koramangala, Bengaluru",
            "distance_km": 1.2,
            "delivery_eta_minutes": 18,
            "is_open": true,
            "rating": 4.6,
            "review_count": 312,
            "logo_url": "https://cdn.nammamedmate.com/pharmacies/sai-medicals.png",
            "current_offer": "Free delivery on orders above ₹199",
            "categories_available": ["OTC"],
            "items_count": 1240,
            "open_hours": "08:00 AM - 10:00 PM",
            "address": "12, 80 Feet Road, Koramangala"
          }
        }
      '''
    }
  }
}

example {
  name: 404 PHARMACY_NOT_FOUND
  request: {
    url: {{baseUrl}}/api/v1/pharmacies/00000000-0000-4000-8000-000000000099
    method: get
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  response: {
    status: { code: 404 text: Not Found }
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": { "code": "PHARMACY_NOT_FOUND", "message": "Pharmacy not found" }
        }
      '''
    }
  }
}
