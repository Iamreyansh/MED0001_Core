meta {
  name: csat
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/support/tickets/{{supportTicketUuid}}/csat
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "score": 5,
    "feedback": "Resolved quickly"
  }
}

script:pre-request {
  if (!bru.getEnvVar("accessToken")) {
    throw new Error("accessToken missing");
  }
  if (!bru.getEnvVar("supportTicketUuid")) {
    throw new Error("supportTicketUuid missing");
  }
}

script:post-response {
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("csat envelope", function () {
    const body = res.getBody();
    expect(body.success).to.equal(true);
    expect(body.data.csat_score).to.equal(5);
  });
}

docs {
  POST /api/v1/support/tickets/:id/csat — authenticated CSAT submission after resolve.
}

example {
  name: 200 OK
  request: {
    url: {{baseUrl}}/api/v1/support/tickets/{{supportTicketUuid}}/csat
    method: post
    headers: {
      Authorization: Bearer {{accessToken}}
      Content-Type: application/json
    }
    body:json: {
      {
        "score": 5,
        "feedback": "Resolved quickly"
      }
    }
  }
  response: {
    status: { code: 200 text: OK }
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "ticket_id": "TKT-20260724-000042",
            "csat_score": 5,
            "csat_feedback": "Resolved quickly"
          }
        }
      '''
    }
  }
}
