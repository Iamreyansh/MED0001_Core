#!/usr/bin/env bash
# Require make check before any push; refuse pushes that update main/master.
set -euo pipefail

remote="${1:-}"
url="${2:-}"

protected_ref_update=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "error: push to '${remote_ref#refs/heads/}' is blocked (use a PR from a feature branch)."
      protected_ref_update=1
      ;;
  esac
done

if [[ "$protected_ref_update" -ne 0 ]]; then
  exit 1
fi

root="$(git rev-parse --show-toplevel)"
echo "==> pre-push: make check (remote=${remote:-?} ${url:-})"
make -C "$root" check
