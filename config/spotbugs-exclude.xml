<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Dependency-injected collaborators are intentionally stored as fields. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- Immutable / DTO accessors returning unmodifiable lists or cloned arrays. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP"/>
    <Or>
      <Class name="~.*\.DomainEvent"/>
      <Class name="com.nammamedmate.auth.adapter.in.web.dto.CreatePharmacyRoleRequest"/>
      <Class name="com.nammamedmate.auth.adapter.in.web.dto.UpdateRolePermissionsRequest"/>
      <Class name="com.nammamedmate.auth.application.port.out.PharmacyRoleRecord"/>
      <Class name="com.nammamedmate.auth.application.port.out.RolePermissionCache$OptionalPermissions"/>
      <Class name="com.nammamedmate.auth.domain.AdminRoleDefinitions$AdminRole"/>
      <Class name="com.nammamedmate.auth.adapter.out.persistence.PharmacyRoleEntity"/>
      <Class name="com.nammamedmate.pharmacy.adapter.in.web.AdminBulkJobController$BulkActionRequest"/>
      <Class name="com.nammamedmate.pharmacy.application.port.out.PharmacyNoticeStore$NoticeRow"/>
      <Class name="com.nammamedmate.pharmacy.application.port.out.BulkActionJobStore$JobRow"/>
      <Class name="com.nammamedmate.pharmacy.application.AdminPharmacyActionsService$NoticeResult"/>
      <Class name="com.nammamedmate.pharmacy.application.AdminPharmacyActionsService$NotesListResult"/>
    </Or>
  </Match>
</FindBugsFilter>
